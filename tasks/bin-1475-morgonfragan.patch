diff --git a/functions/src/episodeDigest/index.ts b/functions/src/episodeDigest/index.ts
new file mode 100644
index 0000000..2d535b1
--- /dev/null
+++ b/functions/src/episodeDigest/index.ts
@@ -0,0 +1,140 @@
+/**
+ * BIN-1475 — the morning question: ONE inbox card and ONE push per user at 08:00
+ * Stockholm, "Igår kom 3 avsnitt du följer", opening a list where each episode
+ * can be ticked off.
+ *
+ * Input is the queue episodeReleaseNotify leaves on episodeNotifyState/{tmdbId}
+ * (`hasPending`, `pending[]`). Nothing is sent per episode any more.
+ *
+ * At send time, not at queue time, each user is checked again: the "Nya avsnitt"
+ * setting is still on, the series is still followed ('mina'), and the episode is
+ * not already watched. A user who changed their mind overnight gets nothing.
+ *
+ * Idempotency: the card id carries the run's Stockholm date and is written with
+ * create(); a retry finds it and sends no second push, so a user gets at most one
+ * push per day. The card is the load-bearing write; the push after it is best
+ * effort, so a push failure never makes the user count as failed (a failed user
+ * would be told again tomorrow under a new card id). Afterwards each show's queue
+ * loses exactly the uids this run finished with, inside a transaction, so an
+ * episode queued meanwhile is kept. Admin SDK bypasses firestore.rules; the card
+ * is the user's own inbox doc.
+ */
+
+import { getFirestore, FieldValue } from 'firebase-admin/firestore';
+import { onSchedule } from 'firebase-functions/v2/scheduler';
+import { logger } from 'firebase-functions/v2';
+import { sendPushToUser } from '../push';
+import { stockholmDayId } from '../util/dayId';
+import { mediaTypeDocId } from '../shared/mediaTypeDocId';
+import {
+  MAX_DIGEST_ITEMS, alreadyWatched, settlePending, allAiredYesterday, digestBody, digestTitle, groupQueueByUser, onePerShow,
+  type DigestItem, type PendingEpisode,
+} from './logic';
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+async function readQueue(): Promise<Array<{ tmdbId: number; pending: PendingEpisode[] }>> {
+  const snap = await getFirestore().collection('episodeNotifyState').where('hasPending', '==', true).get();
+  const out: Array<{ tmdbId: number; pending: PendingEpisode[] }> = [];
+  for (const d of snap.docs) {
+    const tmdbId = Number(d.id);
+    const pending = d.get('pending');
+    if (Number.isFinite(tmdbId) && Array.isArray(pending)) out.push({ tmdbId, pending: pending as PendingEpisode[] });
+  }
+  return out;
+}
+
+/** The followed, still-unwatched episodes for one user; [] when they should hear nothing. */
+async function itemsForUser(
+  uid: string,
+  queued: Array<{ tmdbId: number; season: number; episode: number; airDate: string | null }>,
+): Promise<{ items: DigestItem[]; pushEnabled: boolean } | null> {
+  const db = getFirestore();
+  const profile = await db.collection('users').doc(uid).get();
+  if (!profile.exists) return null;
+  const settings = profile.data()?.notificationSettings as { episodeReleases?: boolean; pushEnabled?: boolean } | undefined;
+  if (settings?.episodeReleases === false) return null;
+
+  const refs = queued.flatMap((q) => [
+    db.collection('users').doc(uid).collection('watchlist').doc(mediaTypeDocId('tv', q.tmdbId)),
+    db.collection('users').doc(uid).collection('watchlist').doc(String(q.tmdbId)), // legacy bare id
+  ]);
+  const snaps = await db.getAll(...refs);
+  const items: DigestItem[] = [];
+  queued.forEach((q, i) => {
+    const doc = [snaps[i * 2], snaps[i * 2 + 1]].find((s) => s.exists && s.get('mediaType') === 'tv');
+    if (!doc || doc.get('status') !== 'mina') return;
+    const season = doc.get('lastWatchedSeason');
+    const episode = doc.get('lastWatchedEpisode');
+    if (alreadyWatched({
+      lastWatchedSeason: typeof season === 'number' ? season : null,
+      lastWatchedEpisode: typeof episode === 'number' ? episode : null,
+    }, q.season, q.episode)) return;
+    items.push({ tmdbId: q.tmdbId, title: String(doc.get('title') ?? ''), season: q.season, episode: q.episode, airDate: q.airDate });
+  });
+  return { items, pushEnabled: settings?.pushEnabled === true };
+}
+
+async function sendDigest(uid: string, queued: Parameters<typeof itemsForUser>[1], runDate: string, yesterdayId: string): Promise<boolean> {
+  const found = await itemsForUser(uid, queued);
+  if (!found) return false;
+  const items = onePerShow(found.items).filter((i) => i.title !== '').slice(0, MAX_DIGEST_ITEMS);
+  if (items.length === 0) return false;
+
+  const title = digestTitle(items.length, allAiredYesterday(items, yesterdayId));
+  const body = digestBody(items);
+  try {
+    await getFirestore().collection('users').doc(uid).collection('notifications').doc(`episode-digest-${runDate}`).create({
+      kind: 'episode_digest',
+      title,
+      summary: body,
+      episodes: items.map((i) => ({ tmdbId: i.tmdbId, title: i.title, season: i.season, episode: i.episode })),
+      actionUrl: '/my/igar/',
+      read: false,
+      createdAt: FieldValue.serverTimestamp(),
+    });
+  } catch (err) {
+    if ((err as { code?: unknown }).code === 6) return false; // ALREADY_EXISTS: today's card and push are done
+    throw err;
+  }
+  try {
+    await sendPushToUser(uid, { title, body, actionUrl: '/my/igar/', tag: 'episode-digest' }, { pushEnabled: found.pushEnabled });
+  } catch (err) { logger.warn(`episodeMorningDigest: push to ${uid} failed after the card was written`, err); }
+  return true;
+}
+
+export const episodeMorningDigest = onSchedule(
+  { schedule: '0 8 * * *', timeZone: 'Europe/Stockholm', region: 'europe-west1', timeoutSeconds: 300, memory: '256MiB' },
+  async () => {
+    const now = Date.now();
+    const runDate = stockholmDayId(new Date(now));
+    const yesterdayId = stockholmDayId(new Date(now - DAY_MS));
+    let queue: Awaited<ReturnType<typeof readQueue>>;
+    try { queue = await readQueue(); }
+    catch (err) { logger.error('episodeMorningDigest: queue read failed', err); return; }
+
+    const byUser = groupQueueByUser(queue);
+    const failed = new Set<string>();
+    let sent = 0;
+    for (const [uid, queued] of byUser) {
+      try { if (await sendDigest(uid, queued, runDate, yesterdayId)) sent += 1; }
+      catch (err) { failed.add(uid); logger.error(`episodeMorningDigest: user ${uid} failed`, err); }
+    }
+
+    const db = getFirestore();
+    const done = new Set([...byUser.keys()].filter((u) => !failed.has(u)));
+    for (const show of queue) {
+      const readIds = new Set(show.pending.map((p) => p.episodeId));
+      const ref = db.collection('episodeNotifyState').doc(String(show.tmdbId));
+      try {
+        await db.runTransaction(async (tx) => {
+          const current = (await tx.get(ref)).get('pending');
+          const rest = settlePending(Array.isArray(current) ? (current as PendingEpisode[]) : [], readIds, done, now);
+          if (rest.length === 0) tx.update(ref, { pending: FieldValue.delete(), hasPending: FieldValue.delete() });
+          else tx.update(ref, { pending: rest });
+        });
+      } catch (err) { logger.error(`episodeMorningDigest: settling queue for ${show.tmdbId} failed`, err); }
+    }
+    logger.info('episodeMorningDigest done', { shows: queue.length, users: byUser.size, sent, failed: failed.size });
+  },
+);
diff --git a/functions/src/episodeDigest/logic.test.ts b/functions/src/episodeDigest/logic.test.ts
new file mode 100644
index 0000000..1b329c8
--- /dev/null
+++ b/functions/src/episodeDigest/logic.test.ts
@@ -0,0 +1,82 @@
+import { describe, it, expect } from 'vitest';
+import {
+  groupQueueByUser, settlePending, alreadyWatched, onePerShow, allAiredYesterday, digestTitle, digestBody, episodeCode,
+  type DigestItem,
+} from './logic';
+
+const item = (tmdbId: number, title: string, season: number, episode: number, airDate: string | null = '2026-10-30'): DigestItem =>
+  ({ tmdbId, title, season, episode, airDate });
+
+describe('groupQueueByUser', () => {
+  it('collects every show a user is queued for', () => {
+    const m = groupQueueByUser([
+      { tmdbId: 1, pending: [{ episodeId: 11, season: 1, episode: 2, airDate: null, uids: ['a', 'b'] }] },
+      { tmdbId: 2, pending: [{ episodeId: 22, season: 3, episode: 4, airDate: null, uids: ['a'] }] },
+    ]);
+    expect(m.get('a')).toHaveLength(2);
+    expect(m.get('b')).toHaveLength(1);
+  });
+  it('does not list the same episode twice for one user', () => {
+    const e = { episodeId: 11, season: 1, episode: 2, airDate: null, uids: ['a'] };
+    const m = groupQueueByUser([{ tmdbId: 1, pending: [e, e] }]);
+    expect(m.get('a')).toHaveLength(1);
+  });
+});
+
+describe('alreadyWatched', () => {
+  it('is false when nothing is logged', () => {
+    expect(alreadyWatched({ lastWatchedSeason: null, lastWatchedEpisode: null }, 1, 1)).toBe(false);
+  });
+  it('is true at the same or a later episode, false before', () => {
+    expect(alreadyWatched({ lastWatchedSeason: 2, lastWatchedEpisode: 5 }, 2, 5)).toBe(true);
+    expect(alreadyWatched({ lastWatchedSeason: 3, lastWatchedEpisode: 1 }, 2, 9)).toBe(true);
+    expect(alreadyWatched({ lastWatchedSeason: 2, lastWatchedEpisode: 4 }, 2, 5)).toBe(false);
+  });
+});
+
+describe('onePerShow', () => {
+  it('keeps the latest episode per show and sorts by title', () => {
+    const out = onePerShow([item(2, 'Zebra', 1, 1), item(1, 'Andor', 1, 2), item(1, 'Andor', 1, 3)]);
+    expect(out.map((i) => `${i.title}${i.episode}`)).toEqual(['Andor3', 'Zebra1']);
+  });
+});
+
+describe('wording', () => {
+  it('says Igår only when everything aired yesterday', () => {
+    expect(allAiredYesterday([item(1, 'A', 1, 1, '2026-10-30')], '2026-10-30')).toBe(true);
+    expect(allAiredYesterday([item(1, 'A', 1, 1, '2026-10-30'), item(2, 'B', 1, 1, '2026-10-29')], '2026-10-30')).toBe(false);
+    expect(allAiredYesterday([item(1, 'A', 1, 1, null)], '2026-10-30')).toBe(false);
+    expect(allAiredYesterday([], '2026-10-30')).toBe(false);
+  });
+  it('title counts only what is listed', () => {
+    expect(digestTitle(3, true)).toBe('Igår kom 3 avsnitt du följer');
+    expect(digestTitle(1, true)).toBe('Igår kom ett avsnitt du följer');
+    expect(digestTitle(2, false)).toBe('2 nya avsnitt av serier du följer');
+  });
+  it('body names series and code only and folds the rest', () => {
+    const items = [item(1, 'Andor', 2, 1), item(2, 'Bear', 3, 4), item(3, 'Cobra', 1, 1), item(4, 'Dune', 1, 2)];
+    expect(digestBody(items)).toBe('Andor S02E01, Bear S03E04, Cobra S01E01 och 1 till');
+    expect(digestBody(items.slice(0, 1))).toBe('Andor S02E01');
+    expect(episodeCode(1, 2)).toBe('S01E02');
+  });
+});
+
+describe('settlePending', () => {
+  const ep = (episodeId: number, uids: string[], queuedAt?: number) => ({ episodeId, season: 1, episode: episodeId, airDate: null, uids, queuedAt });
+  it('removes only finished uids from entries it read', () => {
+    const out = settlePending([ep(1, ['a', 'b'])], new Set([1]), new Set(['a']), 0);
+    expect(out).toEqual([ep(1, ['b'])]);
+  });
+  it('drops an entry once everyone is finished', () => {
+    expect(settlePending([ep(1, ['a'])], new Set([1]), new Set(['a']), 0)).toEqual([]);
+  });
+  it('keeps an entry queued while the run was going', () => {
+    const out = settlePending([ep(1, ['a']), ep(2, ['a'])], new Set([1]), new Set(['a']), 0);
+    expect(out).toEqual([ep(2, ['a'])]);
+  });
+  it('drops entries older than three days', () => {
+    const day = 24 * 60 * 60 * 1000;
+    expect(settlePending([ep(1, ['a'], 0)], new Set(), new Set(), 4 * day)).toEqual([]);
+    expect(settlePending([ep(1, ['a'], 0)], new Set(), new Set(), 2 * day)).toHaveLength(1);
+  });
+});
diff --git a/functions/src/episodeDigest/logic.ts b/functions/src/episodeDigest/logic.ts
new file mode 100644
index 0000000..33fe2f8
--- /dev/null
+++ b/functions/src/episodeDigest/logic.ts
@@ -0,0 +1,115 @@
+/**
+ * Pure helpers for the morning episode question (BIN-1475): grouping the queue
+ * episodeReleaseNotify leaves per show into one list per user, and the wording.
+ * No firebase-admin import, so it runs under the root Vitest suite.
+ */
+
+export interface PendingEpisode {
+  episodeId: number;
+  season: number;
+  episode: number;
+  /** TMDB air_date (YYYY-MM-DD) or null when TMDB had none. */
+  airDate: string | null;
+  uids: string[];
+  /** ms epoch when the episode was queued; older than MAX_QUEUE_AGE_MS is dropped. */
+  queuedAt?: number;
+}
+
+/** A queued episode nobody has been told about by now is stale, not owed. */
+export const MAX_QUEUE_AGE_MS = 3 * 24 * 60 * 60 * 1000;
+
+export interface DigestItem {
+  tmdbId: number;
+  title: string;
+  season: number;
+  episode: number;
+  airDate: string | null;
+}
+
+/** Cap on rows in the card; the count in the text is of the rows actually listed. */
+export const MAX_DIGEST_ITEMS = 12;
+
+export function episodeCode(season: number, episode: number): string {
+  return `S${String(season).padStart(2, '0')}E${String(episode).padStart(2, '0')}`;
+}
+
+/** One entry per (user, show, episode) from the per-show queue docs. */
+export function groupQueueByUser(
+  queue: ReadonlyArray<{ tmdbId: number; pending: readonly PendingEpisode[] }>,
+): Map<string, Array<{ tmdbId: number; season: number; episode: number; airDate: string | null }>> {
+  const out = new Map<string, Array<{ tmdbId: number; season: number; episode: number; airDate: string | null }>>();
+  const seen = new Set<string>();
+  for (const show of queue) {
+    for (const p of show.pending) {
+      for (const uid of p.uids) {
+        const key = `${uid}|${show.tmdbId}|${p.episodeId}`;
+        if (seen.has(key)) continue;
+        seen.add(key);
+        const list = out.get(uid) ?? [];
+        list.push({ tmdbId: show.tmdbId, season: p.season, episode: p.episode, airDate: p.airDate });
+        out.set(uid, list);
+      }
+    }
+  }
+  return out;
+}
+
+/** True when the user already watched this episode or a later one of the show. */
+export function alreadyWatched(
+  progress: { lastWatchedSeason: number | null; lastWatchedEpisode: number | null },
+  season: number,
+  episode: number,
+): boolean {
+  if (progress.lastWatchedSeason == null) return false;
+  const s = progress.lastWatchedSeason;
+  const e = progress.lastWatchedEpisode ?? 0;
+  return s > season || (s === season && e >= episode);
+}
+
+/** One row per show: if a show queued two episodes, the later one stands for it. */
+export function onePerShow(items: DigestItem[]): DigestItem[] {
+  const latest = new Map<number, DigestItem>();
+  for (const it of items) {
+    const cur = latest.get(it.tmdbId);
+    if (!cur || it.season > cur.season || (it.season === cur.season && it.episode > cur.episode)) latest.set(it.tmdbId, it);
+  }
+  return [...latest.values()].sort((a, b) => a.title.localeCompare(b.title, 'sv'));
+}
+
+/** "Igår" is only said when every listed episode aired yesterday (Stockholm). */
+export function allAiredYesterday(items: readonly DigestItem[], yesterdayId: string): boolean {
+  return items.length > 0 && items.every((i) => i.airDate === yesterdayId);
+}
+
+export function digestTitle(count: number, airedYesterday: boolean): string {
+  if (airedYesterday) return count === 1 ? 'Igår kom ett avsnitt du följer' : `Igår kom ${count} avsnitt du följer`;
+  return count === 1 ? 'Nytt avsnitt av en serie du följer' : `${count} nya avsnitt av serier du följer`;
+}
+
+/** Series name and code only, never the episode title or plot (no spoilers). */
+export function digestBody(items: readonly DigestItem[]): string {
+  const shown = items.slice(0, 3).map((i) => `${i.title} ${episodeCode(i.season, i.episode)}`);
+  const rest = items.length - shown.length;
+  return rest > 0 ? `${shown.join(', ')} och ${rest} till` : shown.join(', ');
+}
+
+/**
+ * What stays on a show's queue after a run. Only the uids this run finished with
+ * (told, or deliberately skipped) are removed, and only from the entries it read;
+ * an entry queued while the run was going is untouched, so nothing is lost and
+ * nobody is told twice. Entries older than MAX_QUEUE_AGE_MS go as well.
+ */
+export function settlePending(
+  current: readonly PendingEpisode[],
+  readEpisodeIds: ReadonlySet<number>,
+  doneUids: ReadonlySet<string>,
+  nowMs: number,
+): PendingEpisode[] {
+  const out: PendingEpisode[] = [];
+  for (const p of current) {
+    if (p.queuedAt != null && nowMs - p.queuedAt > MAX_QUEUE_AGE_MS) continue;

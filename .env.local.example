# TMDB
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sentry (valfritt)
# Lämna tomt lokalt — då skickas inga events. Sätts bara i produktion.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_GIT_SHA=

# Firebase Emulator
# Sätt true för att koppla appen mot lokala emulatorerna (firebase emulators:start).
# Auth kör på :9099, Firestore på :8080. OBS: appen skriver då inte till produktions-
# datan — perfekt för att testa rules-ändringar utan risk.
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false

# Firebase App Check (reCAPTCHA v3 site key)
# Skyddar Firestore + Auth mot bot-abuse. Lämna tomt lokalt —
# då hoppar initialiseringen över.
# Skapa nyckeln i Firebase Console: App Check → Register app → reCAPTCHA v3.
NEXT_PUBLIC_APP_CHECK_SITE_KEY=

# FCM Web Push (Fas 4) — VAPID public key
# Krävs för push-notifs. Lämna tomt lokalt — då gömmer settings-toggle:n
# en "ej konfigurerad"-text. Generera nyckeln i Firebase Console:
# Project Settings → Cloud Messaging → Web Push certificates → Generate key pair.
# OBS: Push-notifs kräver Blaze-plan på Firebase-projektet (Cloud Functions).
NEXT_PUBLIC_FCM_VAPID_KEY=

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      // Admin-flaggan (users/{uid}.isAdmin) får bara settas manuellt via
      // Firebase Console. users/{uid} write-regeln nedan förbjuder klienten
      // att sätta fältet själv på create eller update — privilegiet kan
      // alltså inte eskaleras från klient.
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Usernames: 3-20 chars, lowercase a-z, 0-9, underscore and dash;
    // must start and end with alphanumeric. Matches client regex in
    // src/lib/firebase/username.ts.
    function isValidUsername(u) {
      return u is string
        && u.size() >= 3 && u.size() <= 20
        && u.matches('^[a-z0-9]([a-z0-9_-]{1,18}[a-z0-9])?$');
    }

    // Denormaliserade identitetsfält (username/displayName) får inte förfalskas.
    // De måste matcha avsändarens egen profil-doc, annars kan en användare
    // skriva en recension/kommentar som ser ut att komma från någon annan (M5).
    // Optionella fält valideras bara när de är satta — saknas de är det OK.
    //
    // BIN-1126: tar VÄRDENA, inte dokumentet, så samma jämförelse kan användas av
    // en samling som stavar nycklarna annorlunda (`fromDisplayName`/`fromUsername`
    // på en vänförfrågan). Ett andra exemplar av samma jämförelse hade blivit två
    // sanningar om vad "din egen identitet" betyder.
    //
    // Den läser avsändarens PRIVATA `users/{uid}`-dokument, inte den publika
    // projektionen. Skillnaden är load-bearing: projektionens läsregel är gatad på
    // synlighet, så en klient kan inte alltid läsa den — men en regel-intern
    // `get()` är priviligierad och når det privata dokumentet oavsett.
    function isOwnIdentity(displayName, username) {
      return (displayName == null
          || displayName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('displayName', null))
        && (username == null
          || username == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', null));
    }
    // `d.get(k, null)` ger null både när nyckeln saknas och när den är satt till
    // null, vilket är exakt de två fall den gamla lydelsen släppte igenom.
    function matchesOwnIdentity(d) {
      return isOwnIdentity(d.get('displayName', null), d.get('username', null));
    }

    // Reviews content bounds.
    function isValidReview(d) {
      return d.uid is string
        && d.tmdbId is int && d.tmdbId > 0
        && d.mediaType in ['movie', 'tv']
        && d.text is string && d.text.size() <= 5000
        && (!('rating' in d) || d.rating == null || (d.rating is number && d.rating >= 0 && d.rating <= 10))
        && (!('spoiler' in d) || d.spoiler is bool)
        && matchesOwnIdentity(d)
        && d.keys().hasOnly([
          'uid', 'tmdbId', 'mediaType', 'text', 'rating', 'spoiler',
          'displayName', 'username', 'title', 'posterPath',
          'createdAt', 'updatedAt'
        ]);
    }

    // Comment content bounds.
    function isValidComment(d) {
      return d.uid is string
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 1000
        && matchesOwnIdentity(d);
    }

    // Episode reaction content bounds (BIN-95). Mirrors reviews: own uid +
    // non-forgeable identity + bounded text + field whitelist.
    function isValidReaction(d) {
      return d.uid is string
        && d.tmdbId is int && d.tmdbId > 0
        && d.seasonNumber is int && d.seasonNumber >= 0
        && d.episodeNumber is int && d.episodeNumber > 0
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 2000
        && (!('spoiler' in d) || d.spoiler is bool)
        && d.mediaType == 'tv'
        && matchesOwnIdentity(d)
        && d.keys().hasOnly([
          'uid', 'tmdbId', 'mediaType', 'seasonNumber', 'episodeNumber',
          'text', 'spoiler', 'displayName', 'username', 'createdAt', 'updatedAt'
        ]);
    }

    // List content bounds.
    function isValidList(d) {
      return d.uid is string
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 100
        && (!('description' in d) || d.description is string && d.description.size() <= 500)
        && d.isPublic is bool
        // BIN-100: optional editors[] (co-editor uids). Owner-managed; bounded.
        && (!('editors' in d) || (d.editors is list && d.editors.size() <= 20));
    }

    // Watchlist-item fältkontrakt (A2.1). Merge-writes betyder att
    // request.resource.data är hela post-merge-doc:et, så listan måste täcka
    // *varje* fält som en watchlist-doc någonsin kan hålla — unionen av allt
    // WatchlistContext skriver (addItem/updateStatus/updateRating/.../updateProgress).
    function isValidWatchlistItem(d) {
      return d.keys().hasOnly([
        'tmdbId', 'mediaType', 'status', 'rating', 'notes', 'title',
        'posterPath', 'releaseYear', 'totalSeasons', 'lastWatchedSeason',
        'lastWatchedEpisode', 'dropped', 'rewatchCount', 'providers',
        'providersCheckedAt', 'visibility', 'genreIds', 'tmdbStatus',
        'effectiveVisibility', 'isPublic', 'addedAt', 'updatedAt', 'watchedAt',
        // BIN-93: lazy runtime-backfill från titelsidor (setRuntime). Utan denna
        // nekades merge-skrivningen ({ runtime }) av hasOnly → permission-denied
        // på varje in-library titelvisning, och speltids-filtret fick aldrig data.
        'runtime',
        // Instant week (2026-07): denormaliserade next-air-fält, skrivna av
        // nextAirReadRepair (tyst read-repair, aldrig user-edit — bumpar ALDRIG
        // updatedAt; se nextAirReadRepair.ts för de bindande invarianterna).
        'nextAirDate', 'nextAirCode', 'nextAirProvider', 'nextAirUpdatedAt',
        'digitalReleaseDate',
        // BIN-349: tidpunkt då användaren satte/ändrade betyget (serverTimestamp,
        // skrivs av updateRating/addItem). Rekommendations-ankaret "din senaste
        // 5★" läser detta i st. f. updatedAt (som varje redigering bumpar).
        'ratedAt',
        // BIN-402: doc-nivå freshness-stämpel för TMDB-derived-blocket. Skrivs av
        // klienten (addItem/nextAirReadRepair/titelsidan) vid denormalisering OCH
        // av den månatliga tmdbFieldsSweep-funktionen (Admin SDK, förbigår rules).
        // MÅSTE stå med i hasOnly: en merge-write utvärderas mot HELA post-merge-
        // doc:et, så när stämpeln väl finns på en doc skulle nästa vanliga
        // klient-write (rating/status/…) annars falla på hasOnly → permission-denied
        // på en helt orelaterad användaråtgärd. ADR 0009. EN-VÄGS-SPÄRR: ta aldrig
        // bort denna post medan någon prod-doc bär stämpeln (rollback → samma
        // permission-denied-klass). Rulla i så fall tillbaka klient-skrivaren först.
        'tmdbFieldsRefreshedAt',
        // BIN-814: abonnemangs-delmängden av `providers` (flatrate/free/ads, utan
        // rent/buy). Skrivs av titelsidan och taste-backfillen i samma svep som
        // `providers`, från samma TMDB-svar. SAMMA EN-VÄGS-SPÄRR som stämpeln ovan:
        // tas posten bort medan en prod-doc bär fältet faller varje efterföljande
        // merge-write på hasOnly — även en helt orelaterad betygsättning. Reglerna
        // måste därför deployas FÖRE klienten, aldrig efter.
        'subscriptionProviders'
      ])
      // BIN-143: bind rating-VÄRDET, inte bara nyckeluppsättningen. En ägd
      // watchlist-doc skrivs direkt av användaren; utan denna kunde någon skriva
      // rating: 500 → flödar in i den publika community-aggregaten
      // (titleRatingsAggregate via communityRatingMaintain) → "73/10" på
      // titelsidan. VIKTIGT: watchlist-betyg lagras på 0.5–5-skalan (RatingStars
      // halvsteg; communityRatings/logic.ts; CommunityRating visar ×2 → /10) —
      // INTE 0–10 som reviews. Därför 0–5 här (ett lagrat 7 skulle bli "14/10").
      && (!('rating' in d) || d.rating == null || (d.rating is number && d.rating >= 0 && d.rating <= 5))
      // Instant week: bind längder/typer på read-repair-fälten (junk-data-
      // försäkring, speglar rating-bindningen ovan — självägda docs men
      // publika watchlists läses av andra användare).
      && (!('nextAirDate' in d) || d.nextAirDate == null || (d.nextAirDate is string && d.nextAirDate.size() <= 32))
      && (!('nextAirCode' in d) || d.nextAirCode == null || (d.nextAirCode is string && d.nextAirCode.size() <= 16))
      && (!('nextAirProvider' in d) || d.nextAirProvider == null || (d.nextAirProvider is string && d.nextAirProvider.size() <= 80))
      // BIN-468: nextAirUpdatedAt is now the next-air GROUP's sweep freshness gate
      // (the sweep trusts it to decide the group is stale). Same forge risk as
      // tmdbFieldsRefreshedAt → add the `<= request.time` ratchet, not just a type-bind.
      && (!('nextAirUpdatedAt' in d) || d.nextAirUpdatedAt == null
          || (d.nextAirUpdatedAt is timestamp && d.nextAirUpdatedAt <= request.time))
      && (!('digitalReleaseDate' in d) || d.digitalReleaseDate == null || (d.digitalReleaseDate is string && d.digitalReleaseDate.size() <= 32))
      // BIN-349: ratedAt måste vara en timestamp (eller null/frånvarande) —
      // hasOnly kollar bara nyckeln, inte typen; utan denna kunde en klient
      // skriva skräp under nyckeln och störa rekommendations-sorteringen.
      && (!('ratedAt' in d) || d.ratedAt == null || d.ratedAt is timestamp)
      // BIN-402: sweep-stämpeln är en serverTimestamp (eller null/frånvarande).
      // Type-bind + `<= request.time` (Security-panel): en klient kan annars via en
      // rå merge-write sätta en FRAMTIDA stämpel och få sweepen att för evigt tro att
      // doc:en är färsk → hoppar över rensning → underminerar ToS-kontrollen. En
      // ärlig klient skriver serverTimestamp() (== request.time) och passerar.
      && (!('tmdbFieldsRefreshedAt' in d) || d.tmdbFieldsRefreshedAt == null
          || (d.tmdbFieldsRefreshedAt is timestamp && d.tmdbFieldsRefreshedAt <= request.time))
      // BIN-468: providersCheckedAt is the providers GROUP's sweep freshness gate.
      // It had NO validation before (only a hasOnly key) — a client could write junk
      // or a FUTURE timestamp to make the sweep skip the providers group forever.
      // Same type-bind + one-way `<= request.time` ratchet as the other gate stamps.
      && (!('providersCheckedAt' in d) || d.providersCheckedAt == null
          || (d.providersCheckedAt is timestamp && d.providersCheckedAt <= request.time));
    }

    // media-type doc-id migration: shared optional-but-validated mediaType guard for
    // the four personal-library validators below (tags/notes/episodeProgress/
    // notInterested). Keeps the ['movie','tv'] allow-list in ONE place so all four
    // surfaces stay provably identical — add a third media type once, not four times.
    // Docs are keyed `${mediaType}_${tmdbId}` and carry mediaType as a redundant
    // field. Optional presence is deliberate (matches the isValidReview rating idiom):
    // the pre-cutover client writes these docs WITHOUT mediaType and must keep passing
    // while rules ship LIVE before Phase 4.
    function validOptionalMediaType(d) {
      return !('mediaType' in d) || d.mediaType in ['movie', 'tv'];
    }

    // BIN-164: owner-only per-title tags. Free-text tags capture third-party
    // personal data ("med mamma") so they must NEVER be readable by other users
    // — they live in this separate subcollection (NOT on the publicly-readable
    // watchlist doc). Cap the array server-side (mirrors isValidList's
    // editors.size() bound); per-tag string length is enforced client-side
    // (normalizeTags) since rules can't iterate list elements.
    function isValidTagDoc(d) {
      return d.keys().hasOnly(['tags', 'mediaType'])
        && d.tags is list && d.tags.size() <= 15
        && validOptionalMediaType(d);
    }

    // BIN-505: owner-only per-title free-text notes. Same reasoning as tags
    // (free text captures third-party personal data) — moved OFF the
    // public/friends-readable watchlist doc into this owner-only subcollection.
    // Shape { note: string } (or null to clear); bounded length.
    function isValidNoteDoc(d) {
      return d.keys().hasOnly(['note', 'mediaType'])
        && (d.note == null || (d.note is string && d.note.size() <= 5000))
        && validOptionalMediaType(d);
    }

    // BIN-505: public profile PROJECTION contract. users/{uid} is owner-locked
    // (it carries email/hemkommun/providerCosts/providerCampaigns and reads are
    // whole-doc, so public/friends read leaked everything). publicProfiles/{uid}
    // is a POSITIVE whitelist of ONLY public-safe DISPLAY fields — a field added
    // to users/{uid} later is private by default. Value-bound each field (Security
    // #4: hasOnly alone lets a client write oversized junk). `myProviders` is
    // deliberately EXCLUDED (Malin 2026-07-14: which-services is not public).
    function isValidPublicProfile(d) {
      return d.keys().hasOnly(['displayName', 'username', 'photoURL', 'bio', 'isPublic', 'createdAt', 'updatedAt'])
        && (!('isPublic' in d) || d.isPublic is bool)
        && (!('displayName' in d) || d.displayName == null
          || (d.displayName is string && d.displayName.size() <= 80))
        && (!('bio' in d) || d.bio == null
          || (d.bio is string && d.bio.size() <= 160))
        && (!('username' in d) || d.username == null || isValidUsername(d.username))
        && (!('photoURL' in d) || d.photoURL == null
          || (d.photoURL is string && d.photoURL.size() <= 500))
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    // ---- users ----
    // User profile — owner only (public read handled by isPublic check in app).
    // VIKTIGT: write-regeln förbjuder owner att själv sätta isAdmin-flaggan.
    // Den flaggan kan BARA settas manuellt via Firebase Console av en riktig
    // admin — annars blir hela admin-systemet trivialt eskalerbart via
    // klient-skrivning.
    match /users/{uid} {
      // BIN-505: profil-doc:et är nu ENBART ägar-läsbart. Det bär känsliga fält
      // (email, hemkommun, providerCosts, providerCampaigns, notificationSettings,
      // rotationSchedule, ...) och Firestore-läsningar är hel-doc — de kan inte
      // fält-filtreras — så den gamla publik/vän-läsningen läckte ALLT över tråden
      // (klient-blankning är ingen säkerhetsgräns). Publik/vän-synliga display-fält
      // serveras nu via publicProfiles/{uid} (positiv whitelist). Rules-INTERNA
      // get(users/...) (isAdmin, matchesOwnIdentity, following/followers,
      // watchlist-friends-fallback) är priviligierade läsningar som förbigår den
      // här read-regeln, så de fortsätter fungera oförändrat.
      allow read: if isOwner(uid);
      // BIN-1134/BIN-1142: create bar bara isAdmin-spärren. Bio- och
      // displayName-klausulerna nedan fanns bara på `update`, så en profil kunde
      // skrivas med ett godtyckligt långt namn vid registreringen.
      //
      // Det är inte bara lagring på ens eget dokument: `functions/src/index.ts`
      // läser `users/{uid}.displayName` auktoritativt och bygger notistexten av
      // det, så namnet visas på någon ANNANS låsskärm. `isOwnIdentity` binder
      // dessutom `friendRequests.fromDisplayName` och `groupInvites.fromDisplayName`
      // mot samma fält; de bär en egen 80-gräns bredvid bindningen, så ett otyglat
      // värde kopieras inte vidare — det gör i stället varje inbjudan och varje
      // vänförfrågan från det kontot nekad.
      //
      // Talen är update-grenens egna (80 / 160), inte nya. Flyttas ett av dem
      // måste båda grenarna flytta i samma redigering.
      allow create: if isOwner(uid)
        && !('isAdmin' in request.resource.data)
        && (!('bio' in request.resource.data)
          || request.resource.data.bio == null
          || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
        && (!('displayName' in request.resource.data)
          || request.resource.data.displayName == null
          || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80));
      allow update: if isOwner(uid)
        && (
          // Får inte sätta/röra isAdmin via update
          !('isAdmin' in request.resource.data)
          || request.resource.data.isAdmin == resource.data.get('isAdmin', false)
        )
        // Bio + displayName längd-/typvalidering (L4) — bara när fältet är satt.
        && (!('bio' in request.resource.data)
          || request.resource.data.bio == null
          || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
        && (!('displayName' in request.resource.data)
          || request.resource.data.displayName == null
          || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80));
      allow delete: if isOwner(uid);
    }
    match /users/{uid}/watchlist/{itemId} {
      allow read, delete: if isOwner(uid);
      // BIN-505: `notes` moved to the owner-only watchlistNotes subcollection.
      // The key STAYS whitelisted in isValidWatchlistItem (one-way-ratchet: a
      // legacy doc still carrying `notes` must keep passing unrelated merge-writes,
      // and the migration deletes the field via FieldValue.delete()). But NO new
      // non-null note may be written to this public/friends-readable doc:
      //  - create: notes must be absent/null (new items never carry inline notes).
      //  - update: notes must be absent/null OR UNCHANGED from what's stored
      //    (lets an unrelated rating/status edit on an un-migrated legacy doc pass;
      //    blocks a stale client bundle from re-introducing a note = re-leak).
      // BIN-766 — bind the doc-id FORM, create-only. Identical in shape and reason
      // to `canonicalSwipeDocId` in the sessions block below; read that comment for
      // the create-vs-update argument, which applies here unchanged.
      //
      // Why this rule and the communityRatings aggregate are ONE change: that
      // function derives the aggregate key from this path, and it now canonicalises
      // the numeric part (`movie_042` -> `movie_42`) instead of trusting the path
      // verbatim. Canonicalisation is what fixes the split average — and it is also
      // what makes every alias spelling land on the SAME publicly-read document.
      // Without this guard that turns a harmless fragmentation into an unbounded
      // self-stuffing path: the aggregate is a running counter, so one account
      // creating movie_042, movie_0042, movie_00042 … would add one genuine +1 each
      // to a single title's badge. Do not ship one half without the other.
      //
      // Which writes this can refuse, and why that is the intended outcome.
      //
      // FOUR modules write here, and they split by MECHANISM, not by safety. Two BUILD
      // the id, both through mediaTypeDocId() with `tmdbId` typed `number` — a JS number
      // template-literals without leading zeros, so neither can emit an alias shape and
      // neither can ever be refused by THIS guard:
      //   · src/contexts/WatchlistContext.tsx — the create path.
      //   · src/lib/watchlist/nextAirReadRepair.ts — batch.set(…, {merge:true}), which
      //     genuinely CAN create; its `tmdbId` is typed `number`.
      // Two REUSE an id read off a live snapshot, so either could carry a grandfathered
      // bare-numeric shape — but neither can create, so neither reaches this rule:
      //   · src/lib/taste/backfill.ts — updateDoc(), which cannot create at all, so it
      //     only touches documents that already exist. That is why `update` must stay
      //     unguarded.
      //   · src/contexts/AuthContext.tsx — cascadeVisibilityToItems, which since BIN-942
      //     uses batch.update on `d.ref`. `update` carries an existence precondition
      //     Firestore enforces regardless of rules, so a title deleted between the
      //     getDocs and the commit fails the batch instead of being re-created. Read
      //     that function, not this comment, for the guarantee.
      //
      // CLOSED 2026-08-20 by BIN-942's `requiredWatchlistFields` below — read that
      // function, not this paragraph, for the guarantee. Until then the same race on a
      // CANONICAL id was permitted: the shape matched, and isValidWatchlistItem is a
      // hasOnly CEILING with no required-field FLOOR, so a merge onto a title deleted
      // mid-flight recreated it as a two-field ghost on the public-readable path.
      // Verified against the emulator before the fix, and again after.
      //
      // The cascade fix and the floor are NOT redundant. `batch.update` closes only the
      // cascade's own race; the floor covers every OTHER merge-writer into this
      // collection that can still turn into a create — the ones in WatchlistContext plus
      // nextAirReadRepair. Removing either leaves a live hole.
      //
      // Two independent guards now, and they answer different questions: this one asks
      // whether the ID is canonical, the floor asks whether the PAYLOAD is a real title.
      //
      // (Read sites build this id too — src/hooks/useFriendsWhoSaw.ts:59 — but a read
      // cannot reach a create rule, so they are not what this list is about.)
      //
      // A CLIENT writer that hand-builds an id is what this guard is for. It cannot
      // bind the server: Admin SDK writes bypass rules entirely. No function creates
      // watchlist documents today — tmdbTosSweep/index.ts:124 is a batch.update on
      // paths it already read — but one that did would have to canonicalise itself.
      //
      // BIN-797 (2026-08-24) narrowed this to reject `_0`: TMDB numbers titles from 1,
      // so `movie_0` names nothing. It was NOT the harmless unreadable doc the ticket
      // described — `docToItem(d.data())` in WatchlistContext never sees the doc id, it
      // reads `data.tmdbId`, so such a document rendered as an ordinary library item.
      // CREATE-only, so a pre-existing `_0` doc still reads, updates and deletes.
      // Its twin is `canonicalSwipeDocId` in the sessions block below; the two are
      // deliberate copies and must be narrowed together.
      function canonicalWatchlistDocId(id) {
        return id.matches('^(movie|tv)_[1-9][0-9]*$');
      }
      // BIN-942 — the required-field FLOOR, create-only. isValidWatchlistItem is a
      // `hasOnly` ceiling: it says which keys are ALLOWED and never which are REQUIRED, so
      // a two-field payload passed it happily. That is how a merge-write racing the user's
      // delete resurrected a deleted title as an identity-less ghost — visible on the
      // publicly-readable profile, revealing the account HELD that title after the user
      // asked for it to be gone (Art. 17), and untargetable by removeItem, whose delete key
      // is built from the very fields the ghost lacks.
      //
      // CREATE-ONLY, deliberately, and never on update. A merge-write against an EXISTING
      // document is evaluated as an update, so every ordinary partial edit — a rating, a
      // status, an episode position — keeps passing untouched. Add this to `allow update`
      // and every one of those edits would need to resend the whole identity block.
      //
      // Three fields, not more: `tmdbId`, `mediaType` and `status` are exactly what
      // buildAddPayload's `AlwaysWritten` guarantees on every genuine add, so no legitimate
      // create is refused — including the episode-tick add path BIN-954 shipped, which goes
      // through the same `writeTitle` door. Every other client writer into this collection
      // omits at least `tmdbId` AND `mediaType`, so all of them are refused on a create and
      // none of them is a create anyone intended.
      //
      // The cost is real and accepted: in the race, the raced edit is denied and its own
      // call site logs it. See the dated entry in .claude/rules/accepted-deviations.md for
      // the four-axis scope — what is accepted, what is still fileable, and what re-opens it.
      function requiredWatchlistFields(d) {
        return d.keys().hasAll(['tmdbId', 'mediaType', 'status']);
      }
      allow create: if isOwner(uid) && isValidWatchlistItem(request.resource.data)
        && canonicalWatchlistDocId(itemId)
        && requiredWatchlistFields(request.resource.data)
        && (!('notes' in request.resource.data) || request.resource.data.notes == null);
      allow update: if isOwner(uid) && isValidWatchlistItem(request.resource.data)
        && (!('notes' in request.resource.data) || request.resource.data.notes == null
          || request.resource.data.notes == resource.data.get('notes', null));
      // Tre-state visibility — denormaliserad från parent-profil. WatchlistContext
      // stämplar effectiveVisibility vid skrivning och AuthContext.updateDefault
      // Visibility cascadar när profilen toggles. Sparar en extra doc-read per
      // item (500 items → 500 färre reads).
      allow read: if resource.data.get('effectiveVisibility', '') == 'public';
      allow read: if resource.data.get('effectiveVisibility', '') == 'friends'
        && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid));
      // Legacy-fallback: items från innan tre-state landade har bara isPublic.
      allow read: if !('effectiveVisibility' in resource.data)
        && resource.data.get('isPublic', false) == true;
      // Bakåt-fallback för items utan vare sig isPublic eller effectiveVisibility:
      // slå upp parent-profil. Kostar en get() per doc men håller migrationen
      // tills cascade-stämplingen körts på alla items.
      allow read: if !('effectiveVisibility' in resource.data)
        && !('isPublic' in resource.data)
        && get(/databases/$(database)/documents/users/$(uid)).data.get('isPublic', false) == true;
    }
    // BIN-164: per-title tags — OWNER ONLY, no public/friends read clause by
    // design (see isValidTagDoc). Shape { tags: string[] }. The doc id is
    // mediaTypeDocId(mediaType, tmdbId) since BIN-560 (WatchlistContext.tsx:1045),
    // not a bare tmdbId — the wildcard's NAME is the pre-cutover leftover.
    match /users/{uid}/watchlistTags/{tmdbId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidTagDoc(request.resource.data);
    }
    // BIN-505: per-title free-text notes — OWNER ONLY, no public/friends read
    // clause (same design as watchlistTags). Shape { note: string }. Same doc-id
    // story as watchlistTags: mediaTypeDocId() since BIN-560 (WatchlistContext.tsx:549),
    // despite the wildcard still being named {tmdbId}.
    match /users/{uid}/watchlistNotes/{tmdbId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidNoteDoc(request.resource.data);
    }
    match /users/{uid}/episodeProgress/{itemId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        // media-type doc-id migration — shared optional-but-validated guard.
        && request.resource.data.keys().hasOnly(['tmdbId', 'seasons', 'mediaType'])
        && validOptionalMediaType(request.resource.data);
    }
    match /users/{uid}/notInterested/{itemId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['tmdbId', 'mediaType', 'addedAt'])
        // media-type doc-id migration sibling: this collection already ALLOWED
        // mediaType but never value-checked it — route through the shared guard so a
        // garbage type can't land on the one sibling already carrying the field.
        && validOptionalMediaType(request.resource.data);
    }

    // Sparbeslut-historik för Streamingrådgivaren. Skrivs av resumeProvider
    // när användaren tar av en paus, så "Sparat hittills" + "Senaste
    // sparbesluten" har data att visa. Owner-only — inga andra läser.
    match /users/{uid}/pauseHistory/{historyId} {
      allow read, write: if isOwner(uid);
    }

    // Blockerade användare — endast ägaren läser/skriver. Klient-filter i UI
    // gömmer blockerad användares innehåll (hygien-nivå, inte säkerhetsgräns).
    match /users/{uid}/blocked/{targetUid} {
      allow read, write: if isOwner(uid);
    }

    // Följda listor (BIN-96) — ägar-ägt: doc-id = {listId} man följer. Endast
    // ägaren läser/skriver. create kräver att listan faktiskt finns (kan inte
    // följa en påhittad/raderad lista). Fältkontrakt hindrar doc-uppblåsning.
    match /users/{uid}/listFollows/{listId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['listOwnerUid', 'followedAt'])
        && exists(/databases/$(database)/documents/lists/$(listId));
    }

    // Notifications — owner only
    match /users/{uid}/notifications/{notifId} {
      allow read, write: if isOwner(uid);
    }

    // FCM web-push tokens. Doc-id = autoId, fältet 'token' lagrar registrering-
    // tokenet från getToken({ vapidKey }). Cloud Functions läser dessa för att
    // skicka push vid friend-request och sessionHistory-create. När send returnerar
    // 'messaging/registration-token-not-registered' raderar functions doc:et —
    // men det är admin-SDK-skrivning, inte klient-skrivning.
    match /users/{uid}/fcmTokens/{tokenId} {
      allow read, write: if isOwner(uid);
    }

    // Report-throttle (BIN-25): per-user tidsstämpel som ger server-side
    // rate-limit av reports. Skrivs i samma batch som varje rapport och
    // läses av reports-create-regeln. Bara ägaren skriver, bara fältet
    // lastReportAt satt till request.time (serverTimestamp).
    match /users/{uid}/reportMeta/{docId} {
      allow read: if isOwner(uid);
      // BIN-49: throttle-stämpeln skrivs nu enbart av submitReport-callablen
      // (Admin SDK, kringgår reglerna) inuti dess cooldown-transaktion. Klienter
      // får inte längre skriva den — annars kunde en klient nolla sin egen
      // throttle och kringgå cooldownen. Delete behålls för deleteAccount-kaskaden.
      allow create, update: if false;
      allow delete: if isOwner(uid);
    }

    // Per-user daily rate-limit counter for the askBingeParse (LLM-fallback) callable.
    // Written exclusively by the callable (Admin SDK, bypasses rules) — clients can't
    // create/update (else they'd reset their own limit). Delete for the account cascade.
    match /users/{uid}/askBingeMeta/{docId} {
      allow read: if isOwner(uid);
      allow create, update: if false;
      allow delete: if isOwner(uid);
    }

    // Follow system
    match /users/{uid}/following/{targetUid} {
      allow read: if isOwner(uid);
      allow read: if get(/databases/$(database)/documents/users/$(uid)).data.isPublic == true;
      // BIN-1153: `write` band vem,
      // aldrig vad — agaren kunde skriva godtyckliga nycklar och godtyckligt stora
      // varden. Dokumentet ar dessutom PUBLIKT lasbart nar profilen ar oppen (raden
      // ovan), sa ett uppblast varde blir nagon annans laskostnad.
      //
      // INGEN existsAfter har, till skillnad fran `followers` nedan: den speglade
      // doc:en ligger i MOTTAGARENS trad och skrivs av nagon annan, sa den behover
      // binda vem. Den har ligger i agarens eget trad under isOwner(uid) och har
      // ingen forfalskningsvag att stanga.
      //
      // Bada klausulerna maste ligga pa DEN HAR raden, som tacker create OCH
      // update — annars kan ett rent dokument skapas och sedan uppdateras fullt.
      // Harled skrivarna och deras faltuppsattning i stallet for att lita pa meningen:
      //   git grep -n "'following'" -- src functions
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['followedAt'])
        && request.resource.data.followedAt is timestamp;
      // Delete lamnas oformad med flit: en legacy-rad med fel form maste ga att
      // avfolja bort, annars strandar den for alltid.
      allow delete: if isOwner(uid);
    }
    match /users/{uid}/followers/{followerUid} {
      allow read: if isOwner(uid);
      allow read: if get(/databases/$(database)/documents/users/$(uid)).data.isPublic == true;
      // Följar-spegeln får bara skrivas av följaren själv OCH bara när den
      // matchande following/{uid}-doc:en finns EFTER commit — annars kan vem
      // som helst forga följare för andra (M1). existsAfter (inte exists) krävs
      // eftersom followUser skriver following + followers i samma batch; exists
      // skulle se pre-commit-state där following ännu inte finns och neka.
      //
      // BIN-1141: existsAfter binder VEM som får skriva, aldrig VAD. Dokumentet
      // ligger i mottagarens träd, skrivs av någon annan, och `dataExport.ts`
      // sprider det ordagrant (`toExportDocs(s.followersSnap)`) in i mottagarens
      // GDPR-export — så utan de två klausulerna nedan kunde en främling lägga
      // godtyckliga nycklar och godtyckligt stora värden i min export.
      //
      // Nyckellistan ensam räcker inte: utan `is timestamp` kan `followedAt`
      // fortfarande vara en godtyckligt lång sträng. Båda klausulerna måste ligga
      // på DEN HÄR raden, som täcker både create och update — annars kan ett rent
      // dokument skapas och sedan uppdateras fullt.
      //
      // `reclaimOrphanFollows` läser fältet men skriver aldrig hit, och dess
      // `parseFollowedAt` tål ett saknat/feltypat värde, så typkravet kan inte
      // störa svepet.
      allow create, update: if isOwner(followerUid)
        && existsAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(uid))
        && request.resource.data.keys().hasOnly(['followedAt'])
        && request.resource.data.followedAt is timestamp;
      allow delete: if isOwner(followerUid);
    }

    // ---- friends-system (mutuell relation, kompletterar ensidiga follow) ----
    //
    // Bekräftade vänner. Båda riktningar speglas vid accept (atomisk batch).
    // - users/{A}/friends/{B} = vad B är för A
    // - users/{B}/friends/{A} = vad A är för B
    //
    // Läsning: ägaren ser sin egen lista. Andra parten kan läsa sin egen
    // doc på motsattens sida (för att verifiera att vänskapen finns kvar
    // — annars skulle de inte kunna se sin egen visibility-tier-tillgång).
    match /users/{uid}/friends/{targetUid} {
      allow read: if isOwner(uid) || isOwner(targetUid);
      // Skapa: KRÄVER bevis på en riktig pending request mellan parterna —
      // annars kan vem som helst forga `users/A/friends/C` ensidigt och därmed
      // läsa A:s privata profil + vänner-tier-watchlist (read-reglerna litar på
      // friends-docens blotta existens). Båda grenarna pekar på SAMMA bevis-doc:
      // den inkomna requesten på acceptorns sida (users/{acceptor}/friendRequests/
      // {requester}). acceptFriendRequest skriver båda friends-docs + raderar
      // requesten i en atomisk batch; exists() (inte existsAfter) ser pre-commit-
      // state där requesten fortfarande finns, så den legitima accepten passerar.
      // - ägar-grenen (uid=acceptor): users/$(uid)/friendRequests/$(targetUid)
      // - spegel-grenen (targetUid=acceptor): users/$(targetUid)/friendRequests/$(uid)
      // BIN-1063 steg 2: `uid` maste vara dokumentets EGET id (targetUid).
      // Pinnas mot SOKVAGSVARIABELN, inte mot request.auth.uid — grannregeln
      // friendRequests jamfor mot request.auth.uid och det fungerar dar, men
      // samma monster spricker har: acceptFriendRequest skriver spegelsidan
      // users/{fromUid}/friends/{myUid} som ACCEPTOR, alltsa inte som
      // sokvagens agare. En sadan kopiering hade nekat varje legitim accept.
      //
      // Hela OR:et ar omslutet med flit. `&&` binder hardare an `||`, sa
      // `gren1 || gren2 && koll` hade latit agar-grenen skriva vilket uid som
      // helst — och det ar just det vardet en framtida radering foljer.
      allow create: if
        (
          (isOwner(uid)
            && exists(/databases/$(database)/documents/users/$(uid)/friendRequests/$(targetUid)))
          || (isOwner(targetUid)
            && exists(/databases/$(database)/documents/users/$(targetUid)/friendRequests/$(uid)))
        )
        && request.resource.data.uid == targetUid
        // BIN-1119 ställde samma fråga här som på `friendRequests`: nyckellistan
        // nedan säger vilka nycklar som får finnas, aldrig hur stora de får vara.
        // Svaret skiljer sig, och skälet är att den här mängden är annorlunda:
        // `uid` är pinnad mot sökvägsvariabeln och därmed bunden av dokument-id:ts
        // egen längd, så `since` är den enda nyckel vars värde var fritt. Ett
        // typkrav räcker alltså här — ingen längdgräns behövs, eftersom ingen
        // kvarvarande nyckel bär text.
        && request.resource.data.since is timestamp
        // #4:s villkor i panelen for BIN-1063 steg 2. Spegel-grenen later
        // acceptorn skapa ett dokument under MOTPARTENS trad; utan en
        // nyckelbegransning kan den fylla det med vad som helst upp till
        // dokumentgransen, pa motpartens lagring och rakt in i motpartens
        // GDPR-export. friends.ts skriver exakt dessa tva falt.
        && request.resource.data.keys().hasOnly(['uid', 'since']);
      // Update: aldrig (since-fältet är immutable). Använd delete + create
      // om man vill resetta.
      allow update: if false;
      // Radering: båda parter kan unfriend (och spegelraderar andra hållet).
      allow delete: if isOwner(uid) || isOwner(targetUid);
    }

    // Inkomna vänskapsförfrågningar. Doc-id = avsändarens uid så vi kan slå
    // upp via existens-check och inte läcker pending requests publikt.
    match /users/{uid}/friendRequests/{fromUid} {
      // Bara mottagaren ser sina inkomna requests.
      allow read: if isOwner(uid);
      // Avsändaren skapar request på mottagarens väg. Validera doc-id ===
      // request.auth.uid så ingen kan skapa request "från" någon annan.
      // BIN-1106: samma nyckelbegransning som `friends` och `friendRequestsSent`
      // fick i steg 2. Utan den kan vem som helst som ar inloggad skriva ett
      // dokument med godtyckliga nycklar i NAGON ANNANS trad, upp till
      // Firestores dokumentgrans. Det raknas mot mottagarens lagring, och
      // `dataExport.ts` sprider `d.data()` ordagrant - sa innehallet hamnar rakt
      // in i mottagarens GDPR-export.
      //
      // Listan ar harledd ur `sendFriendRequest` i `src/lib/firebase/friends.ts`,
      // den enda vagen som skapar de har dokumenten. En for smal lista nekar
      // varje skarp vanforfragan, sa den maste komma darifran och inte ur en
      // biljett. `friends.test.ts` pinnar samma mangd fran klientsidan.
      //
      // BIN-1119: `hasOnly` ovan sätter tak på ANTALET nycklar, aldrig på hur mycket
      // som får ligga i dem. Utan värdegränser kan en inloggad främling fördela ett
      // dokument upp mot Firestores gräns över de tillåtna nycklarna — på
      // mottagarens lagring, och rakt in i mottagarens GDPR-export. Talen är INTE
      // nya: de är samma gränser `isValidPublicProfile` redan sätter på samma
      // storheter. En andra siffra här hade glidit isär från den.
      //
      // `fromUsername` bunds på typ och längd, inte på `isValidUsername`s
      // teckenmönster. Fältet är en visnings-cache, aldrig en uppslagningsnyckel, och
      // `users/{uid}.username` valideras inte av någon regel — bara reservationen
      // under `usernames/` gör det. Ett mönsterkrav här hade alltså kunnat neka en
      // äkta vänförfrågan från ett konto vars profil bär något regeln aldrig prövat,
      // och det är den dyrare felriktningen (#18).
      //
      // BIN-1126: identiteten binds också till avsändarens EGEN profil, som reglerna
      // redan gör för recensioner, kommentarer och reaktioner. `fromDisplayName` och
      // `fromUsername` renderas för mottagaren och byggs in i push-notisen, så utan
      // bindningen kan vem som helst skicka "Malin (@malin) vill bli vän" utan att
      // vara det. Att i stället låta UI:t slå upp avsändarens riktiga profil räcker
      // inte: `publicProfiles`-läsregeln är gatad på synlighet och parterna är per
      // definition inte vänner än, så för en PRIVAT avsändare faller UI:t tillbaka
      // på just det fältet.
      //
      // Null släpps igenom i båda ändar, så ett konto vars profil saknar namn kan
      // skicka en förfrågan.
      //
      // Kostnaden, vägd innan formen valdes: bindningen läser ett dokument per
      // SKRIVEN vänförfrågan. Repot betalar redan exakt den läsningen på varje
      // skrivväg `matchesOwnIdentity` gatar. Härled vilka de är i stället för att
      // lita på den meningen:
      //
      //   grep -n "matchesOwnIdentity(" firestore.rules
      //
      // Den accepterade avvikelsen som avvisade ett korsdokument-`get()` av
      // kostnadsskäl gällde LÄSREGELN på appens mest trafikerade yta, där varje
      // visning av en titel hade betalat. Den säger ingenting om en skrivväg.
      //
      // `fromPhotoURL` binds INTE, bara längdbegränsas. Den renderas som en bild och
      // aldrig som identitetstext, ingen regel i den här filen har någon
      // domänbegränsning på en photoURL, och profilens egen kan ändras mellan att
      // klienten läste den och att förfrågan skickas — en bindning hade nekat den
      // skrivningen utan att stänga något som texten inte redan stänger.
      allow create: if isSignedIn()
        && fromUid == request.auth.uid
        && request.resource.data.fromUid == request.auth.uid
        // Varje tillåten nyckel måste bäras av ett villkor här. `hasOnly` säger bara
        // vilka nycklar som får finnas, så en nyckel utan typkrav — `sentAt` var en —
        // tar emot en godtycklig sträng och gör de andra gränserna verkningslösa.
        && (request.resource.data.get('fromDisplayName', null) == null
          || (request.resource.data.fromDisplayName is string
            && request.resource.data.fromDisplayName.size() <= 80))
        && (request.resource.data.get('fromUsername', null) == null
          || (request.resource.data.fromUsername is string
            && request.resource.data.fromUsername.size() <= 20))
        && (request.resource.data.get('fromPhotoURL', null) == null
          || (request.resource.data.fromPhotoURL is string
            && request.resource.data.fromPhotoURL.size() <= 500))
        && request.resource.data.sentAt is timestamp
        && isOwnIdentity(
          request.resource.data.get('fromDisplayName', null),
          request.resource.data.get('fromUsername', null))
        && request.resource.data.keys().hasOnly(
          ['fromUid', 'fromDisplayName', 'fromPhotoURL', 'fromUsername', 'sentAt']);
      allow update: if false;
      // Mottagaren kan radera (decline / vid accept). Avsändaren kan
      // också radera sin egen pending request (cancel).
      allow delete: if isOwner(uid) || isOwner(fromUid);
    }

    // Speglad outgoing-tracking på avsändarens sida — så UI kan visa
    // "Förfrågan skickad" utan att läsa annans privata data.
    match /users/{uid}/friendRequestsSent/{toUid} {
      allow read: if isOwner(uid);
      // BIN-1063 steg 2: samma pinning som friends ovan. `update` ar redan
      // false harunder, sa faltet ar oforanderligt utan extra villkor.
      allow create: if isOwner(uid)
        && request.resource.data.uid == toUid
        // BIN-1119, samma svar som på `friends` ovan: `uid` är pinnad mot
        // dokumentets id, så `sentAt` var den enda nyckel vars värde var fritt.
        && request.resource.data.sentAt is timestamp
        && request.resource.data.keys().hasOnly(['uid', 'sentAt']);
      allow update: if false;
      allow delete: if isOwner(uid) || isOwner(toUid);
    }

    // ---- grupp-inbjudningar (samtyckesbaserade) ----
    // Spegel av friendRequests-mönstret. Ägaren av en grupp skapar en inbjudan
    // på mål-användarens väg; mål-användaren ser den, kan acceptera (lägger då
    // till sig själv i gruppen via group-update accept-branchen) eller avböja.
    // Doc-id = groupId så existens-checken i group-regeln blir trivial.
    match /users/{uid}/groupInvites/{groupId} {
      // Bara mottagaren ser sina inbjudningar.
      allow read: if isOwner(uid);
      // Bara gruppens ägare kan bjuda in, och bara någon annan än sig själv.
      //
      // BIN-1127: samma härdning som `friendRequests` fick i BIN-1119/1126, och av
      // samma skäl — dokumentet skrivs i NÅGON ANNANS träd och sprids ordagrant i
      // mottagarens GDPR-export (`toExportDocs` i `src/lib/firebase/dataExport.ts`).
      // Utan nyckellista och värdegränser kunde en gruppägare skriva vad som helst,
      // i vilken storlek som helst, i vem som helsts inkorg.
      //
      // `fromDisplayName` binds mot avsändarens EGEN profil via `isOwnIdentity`.
      // Det är den halva som har säkerhetsvärde: mottagarens UI slår upp
      // avsändarens riktiga namn i `publicProfiles`, vars läsregel är gatad på
      // synlighet. Är avsändaren varken publik eller redan vän faller listan
      // tillbaka på det här fältet, och utan bindningen kunde en främling låna en
      // betrodd persons namn.
      //
      // `groupName` får en EGEN längdgräns och inte bara en pinning mot
      // `groups/{groupId}.name`: en pinning ensam ärver vad källan råkar tillåta,
      // och den här samlingen ligger i mottagarens lagring och GDPR-export. Talet
      // är detsamma som `isValidGroupDoc()` binder källan till, och som formulären
      // använder. Härled båda med
      //   grep -nE "data\.[A-Za-z]+\.size\(\) <= 48" firestore.rules
      //   grep -rn "maxLength=" src/app/grupper src/components/groups
      // De måste flytta i samma redigering.
      allow create: if isSignedIn()
        && uid != request.auth.uid
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.groupId == groupId
        && request.resource.data.invitedAt is timestamp
        && request.resource.data.groupName is string
        && request.resource.data.groupName.size() <= 48
        && (request.resource.data.get('fromDisplayName', null) == null
          || (request.resource.data.fromDisplayName is string
            && request.resource.data.fromDisplayName.size() <= 80))
        && isOwnIdentity(request.resource.data.get('fromDisplayName', null), null)
        && request.resource.data.keys().hasOnly(
          ['groupId', 'groupName', 'fromUid', 'fromDisplayName', 'invitedAt'])
        && request.resource.data.groupName
          == get(/databases/$(database)/documents/groups/$(groupId)).data.name
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid;
      allow update: if false;
      // Mottagaren raderar (accept/decline). Ägaren kan dra tillbaka en inbjudan.
      allow delete: if isOwner(uid)
        || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid;
    }

    // ---- publicProfiles (BIN-505) ----
    // Public projection of a user's DISPLAY fields (see isValidPublicProfile).
    // The private users/{uid} doc is owner-locked; THIS is the only doc a
    // public/friend viewer reads. Visibility is gated LIVE against the source
    // via a privileged get(users/{uid}) so flipping to private takes effect
    // instantly (no stale-public window). Owner-written; a stale display value
    // is merely cosmetic (never a leak), so best-effort client sync is adequate.
    // Top-level (NOT a user subcollection) → wired explicitly into the GDPR
    // export + erasure paths (not covered by KNOWN_USER_SUBCOLLECTIONS).
    match /publicProfiles/{uid} {
      allow read: if isOwner(uid)
        || get(/databases/$(database)/documents/users/$(uid)).data.get('defaultVisibility', '') == 'public'
        || get(/databases/$(database)/documents/users/$(uid)).data.get('isPublic', false) == true
        || (isSignedIn()
          && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)));
      allow create, update: if isOwner(uid) && isValidPublicProfile(request.resource.data);
      allow delete: if isOwner(uid);
    }

    // ---- usernames ----
    // Username lookup — anyone can read, owner can create/delete.
    // Path-segment username must be normalized (lowercase, 3-30, [a-z0-9_]).
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isValidUsername(username);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- reviews ----
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isValidReview(request.resource.data);
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid  // can't transfer ownership
        && isValidReview(request.resource.data);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Likes — each signed-in user owns their own like doc (doc-id = uid).
      match /likes/{uid} {
        allow read: if true;
        // BIN-347: like docs now carry a `uid` field (== doc-id) so a user's likes
        // are enumerable across the collection group (GDPR export/erasure). Validate
        // it on create + lock the field set so the doc can't be bloated.
        allow create: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
        // The liker may remove their own like; the review author may also clear
        // likes on their review (symmetric with comments) — needed so account
        // deletion can erase a review's whole subtree (BIN-347).
        allow delete: if isOwner(uid)
          || (isSignedIn()
            && get(/databases/$(database)/documents/reviews/$(reviewId)).data.uid == request.auth.uid);
      }

      // Comments — any signed-in user may comment; author or review-author may delete.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && isValidComment(request.resource.data);
        allow delete: if isSignedIn() && (
          resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/reviews/$(reviewId)).data.uid == request.auth.uid
        );
      }
    }

    // ---- episode reactions (BIN-95) ----
    // Per-episode reaction threads, keyed episodeReactions/{tmdbId_s_e}/reactions/{id}.
    // Public read (spoiler-gating is client-side against the viewer's own
    // progress); own create/update/delete with non-forgeable identity, mirroring
    // reviews. Reportable via the existing reports collection (no new mod surface).
    match /episodeReactions/{episodeKey}/reactions/{reactionId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isValidReaction(request.resource.data);
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && isValidReaction(request.resource.data);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- Collection-group READ access (BIN-347) ----
    // A collection-group query (used only by collectUserDataSnapshots, for the
    // GDPR export + Art. 17 erasure path) is NOT granted by the nested per-doc
    // rules above — Firestore requires a recursive-wildcard rule for the group,
    // or the query is rejected ("No matching allow statements"). Scope to the
    // OWNER so a user can only enumerate THEIR OWN docs across the group; the
    // per-doc public reads stay governed by the nested rules (rules are additive).
    // Requires the matching uid field + COLLECTION_GROUP index (firestore.indexes.json).
    match /{path=**}/likes/{likeId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
    match /{path=**}/comments/{commentId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
    match /{path=**}/reactions/{reactionId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- reports (UGC-moderation) ----
    // Inloggade användare kan skapa rapporter. Läsning sker off-line via
    // Firebase Console av admins — inga klienter har read-access. Ingen
    // klient kan heller uppdatera eller radera en rapport (admin sätter
    // status via console).
    //
    // Rate-limit: vi litar på klient-cooldown (1 s) + vi begränsar
    // note-size via valideringsregel. En hårdare rate-limit (per user per
    // timme) lägger vi in när vi ser abuse-mönster.
    match /reports/{reportId} {
      // Läsning: vanliga användare får aldrig läsa sina egna eller andras
      // rapporter (sekretess mot reporterad target). Admins får läsa alla.
      allow read: if isAdmin();

      // BIN-49: report-skapande är låst för klienter. Den gamla BIN-25-regeln
      // gate:ade per BATCH (getAfter + throttle i samma batch), så en writeBatch
      // med N report-creates + 1 throttle-skrivning släppte igenom alla N
      // (~499 rapporter/10 s). Rules kan inte räkna syskon-skrivningar i en batch.
      // Lösning: rapporter skapas nu via den server-auktoritativa submitReport-
      // callablen (Admin SDK kringgår reglerna) som enforce:ar en cooldown per uid
      // i en transaktion. Klienter får aldrig skriva direkt.
      allow create: if false;

      // Admin får uppdatera status + lägga till actionedAt/dismissedAt m.m.
      // men får INTE ändra core-fält som skulle manipulera historik.
      allow update: if isAdmin()
        && request.resource.data.status in ['open', 'reviewed', 'actioned', 'dismissed']
        && request.resource.data.reporterUid == resource.data.reporterUid
        && request.resource.data.targetType == resource.data.targetType
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.targetOwnerUid == resource.data.targetOwnerUid
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.createdAt == resource.data.createdAt
        // BIN-357: an admin may only attribute an action to THEIR OWN uid. The sole
        // update path (updateReportStatus) always stamps actionedByUid from the
        // acting admin's auth uid, so this holds for every legit update; it blocks
        // a (future multi-admin) actor from framing another admin in the audit trail.
        && request.resource.data.actionedByUid == request.auth.uid;

      allow delete: if false;
    }

    // ---- insikter (intern analys-dashboard) ----
    // Rollup-dokumenten skrivs enbart av rollupInsights-functionen (admin-SDK,
    // kringgår reglerna) och läses enbart av apiInsights-functionen. Klienten
    // når aldrig collectionen direkt — datan exponeras bara via /api/insights
    // bakom admin/token-auth. Neka därför all klient-åtkomst rakt av.
    match /insights/{doc=**} {
      allow read, write: if false;
    }

    // Weekly-digest dedup marker (doc-id = uid). Written exclusively by the
    // weekly-digest function via Admin SDK (bypasses rules). The owner may read
    // + delete their own marker so account deletion can erase it (BIN-347) —
    // without this rule the cascade's delete is denied and deletion aborts.
    match /weeklyDigestState/{uid} {
      allow read, delete: if isOwner(uid);
    }

    // External ratings cache — public read (no PII; just IMDb/RT/Metacritic scores).
    // Written exclusively by the titleRatings callable via Admin SDK (bypasses rules).
    // Clients read directly on the hot path; the callable is only invoked on cache miss.
    match /titleRatings/{imdbId} {
      allow read: if true;     // public cached ratings (no PII); written by the callable via Admin SDK
      allow write: if false;
    }

    // BIN-185: spoiler-safe episode recaps — public cache keyed {tmdbId}_{s}_{e},
    // shared across all users. Written EXCLUSIVELY by the offline /recap Admin-SDK
    // batch (bypasses rules); no personal data. Clients read directly on the hot
    // path; they can never write/overwrite — a forged recap would be permanent
    // public content served to every viewer of that show.
    match /recaps/{recapId} {
      allow read: if true;
      allow write: if false;
    }

    // Global daily OMDb budget counter — replaces per-user rate-limit.
    // Function-only: Admin SDK writes, no client access.
    match /omdbBudget/{day} {
      allow read, write: if false;   // global daily OMDb cap counter — function-only
    }

    // Fråga Binge LLM-fallback: global daily request ceiling + 24h query cache.
    // Both written/read exclusively by askBingeParse via Admin SDK — fully sealed.
    match /askBingeBudget/{day} {
      allow read, write: if false;
    }
    match /askBingeCache/{hash} {
      allow read, write: if false;
    }

    // Per-user rate-limit counters for the titleRatings callable (legacy, kept inert).
    // Written exclusively by the callable via Admin SDK (bypasses rules).
    // Clients have no direct access — fully sealed.
    match /titleRatingsRateLimit/{uid} {
      allow read, write: if false;
    }

    // Streaming offers (deeplinks, prices, leaving dates) — written by the
    // streamingOffersRefresh cron (Admin SDK bypasses rules), public read.
    match /streamingOffers/{tmdbId} {
      allow read: if true;
      allow write: if false;
    }

    // "Vad försvinner"-rollup (BIN-178) — streamingLeaving/current.byProvider,
    // written by the leavingRollup cron (Admin SDK bypasses rules). Public read
    // (catalog leaving-dates, no PII) for the /forsvinner/[provider] landing
    // pages; never client-written.
    match /streamingLeaving/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Price history (BIN-180) — shared, global cheapest-rent points per title,
    // appended write-on-change by the streamingOffersRefresh cron (Admin SDK
    // bypasses rules). Public read (price data, no PII); never client-written.
    match /priceHistory/{tmdbId} {
      allow read: if true;
      allow write: if false;
    }

    // Community rating aggregate (BIN-104) — {count,sum} per title, maintained
    // by the communityRatingMaintain trigger (Admin SDK). Public read for the
    // "Binge-snitt" på titelsidor; never client-written (no vote-stuffing).
    match /titleRatingsAggregate/{titleId} {
      allow read: if true;
      allow write: if false;
    }

    // Internal freshness/health for the streaming-offers governor — never client-readable.
    match /streamingHealth/{doc} {
      allow read, write: if false;
    }

    // Fråga Binge usage/error counters (BIN-176) — daily aggregate docs written
    // EXCLUSIVELY by the recordAskBinge callable (Admin SDK bypasses rules) and
    // read by /api/insights server-side. Sealed: clients can never read or forge
    // counters directly. Validation/throttling lives in the callable.
    match /askBingeStats/{day} {
      allow read, write: if false;
    }

    // Recap coverage-gap counters (BIN-544) — per-show counts of "user hit a
    // title with no spoiler-safe recap available," written EXCLUSIVELY by the
    // logRecapMiss callable (Admin SDK bypasses rules). Sealed: clients can
    // never read or forge counters directly. Validation lives in the callable.
    match /recapCoverageGaps/{tmdbId} {
      allow read, write: if false;
    }

    // Cineasterna availability catalog — written by the cineasternaCatalogSync cron
    // (Admin SDK bypasses rules), public read (it's catalog data, no PII).
    match /cineasternaCatalog/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ---- lists ----
    match /lists/{listId} {
      allow read: if resource.data.isPublic == true
        || (isSignedIn() && request.auth.uid == resource.data.uid)
        // BIN-100: co-editors can always read the list they edit.
        || (isSignedIn() && request.auth.uid in resource.data.get('editors', []));
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isValidList(request.resource.data);
      // Owner: full control (metadata, editors[], items).
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && isValidList(request.resource.data);
      // BIN-100: co-editor may change ONLY the items array (+ updatedAt). The
      // hasOnly-clause is the safety core — an editor cannot touch isPublic,
      // editors[], uid, title or description, so they can't escalate or hijack.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.get('editors', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'updatedAt']);
      // BIN-149: a co-editor may remove ONLY THEMSELVES from editors[] — the
      // account-deletion cascade strips a leaving user from others' lists so a
      // deleted account doesn't linger as a write-authorized ghost editor.
      // Tightly bounded: only editors[]+updatedAt change, the caller must have
      // been an editor, must NOT remain one, and the new editors[] must equal
      // the old minus exactly their own uid (can't add or drop anyone else).
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.get('editors', [])
        && !(request.auth.uid in request.resource.data.get('editors', []))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['editors', 'updatedAt'])
        && request.resource.data.editors == resource.data.editors.removeAll([request.auth.uid]);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- Tillsammans-sessioner ----
    // Alla med sessions-länken kan läsa. Ingen värdefull data lagras (bara
    // röster), men skrivningar binds sedan BIN-509 till anroparens egen
    // deltagarplats för INLOGGADE: pid == auth.uid och bara den egna
    // röstnyckeln får röras — inloggades röster/platser kan inte förfalskas
    // av någon. Anonyma deltagare (uid == null) kan inte auth-bindas — deras
    // platser/röster skyddas bara av länkens/tokenets ogissbarhet, så en annan
    // länk-innehavare kan förfalska en ANONYM deltagares enskilda röst
    // (accepterad deviation, se .claude/rules/accepted-deviations.md).
    // Expiry-gate på skrivningar är MEDVETET utelämnad (kostnadsbeslut BIN-24
    // e6d02e8, återbekräftat av Malin 2026-07-16 i BIN-509) —
    // retentionCleanup skördar utgångna sessioner.
    // Sessioner kräver autentisering för att skapas
    // (tidigare tillät null hostUid — skräp- och abuse-vektor).
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.hostUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;

      // BIN-509: anonyma deltagar-id:n kommer ALLTID från generateSecureToken()
      // (16 slumpbytes → exakt 32 tecken lowercase hex). Firebase-uids är
      // ~28 tecken blandad bas62 och kan aldrig matcha den formen. Utan denna
      // form-gate kunde en angripare FÖRPLANTERA en "spökplats" (uid null) på
      // ett offers uid-väg INNAN offret joinat, och sedan förfalska en röst som
      // efter offrets riktiga join läses som offrets egen (uids är enumererbara
      // via publika usernames/{name} → {uid}). Form-gaten gör att en anon-plats
      // strukturellt aldrig kan ligga på en riktig uid-väg. (BIN-509 sec-review.)
      function anonShapedPid(p) {
        return p.size() == 32 && p.matches('^[0-9a-f]+$');
      }
      // En röstnyckel tillhör en ANONYM plats om nyckeln är token-formad OCH
      // deltagardokumentet finns och saknar uid. get() körs BARA på anon-vägen
      // (en inloggads egen röst kortsluter före), och form-checken kortsluter
      // före get() för ogiltiga/uid-formade nycklar → ingen extra läsning där.
      // En påhittad nyckel utan deltagardokument nekas (get på saknat doc → deny).
      function voteKeyIsAnonSlot(k) {
        return anonShapedPid(k)
          && get(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(k)).data.uid == null;
      }
      function validVote(v) { return v == 'yes' || v == 'no' || v == 'veto'; }
      // BIN-624: doc-id formkontroll på röstdokument. Exakt den form
      // mediaTypeDocId() skriver — `movie_`/`tv_` + KANONISKA siffror.
      // Utan den kunde vem som helst med sessionslänken skapa
      // sessions/{id}/swipes/<vad som helst>: skräpdokument och kostnad, inte
      // röstintegritet (BIN-636:s granskning visade att inget förfalskat doc-id
      // kan dölja eller förfalska en röst på någondera sidan längre).
      //
      // Den här regeln binder FORMEN, inte ANTALET: en länkinnehavare kan
      // fortfarande skapa movie_1 … movie_999999, var och en med en giltig egen
      // eller anon-röst. Läs alltså inte det här som att skräpdoc-kostnaden är
      // löst — en volymgräns vore en egen biljett.
      //
      // Gäller BARA create. Två skäl, båda avsiktliga:
      //  1. create/update avgörs av om dokumentet FINNS, inte av anroparen — en
      //     angripare kan alltså inte nå update-grenen på en väg utan dokument.
      //     Undantaget öppnar ingenting; det stänger bara alla NYA icke-kanoniska id:n.
      //  2. Legacy bara-numeriska röstdokument (skrivna före namngivningen) slås
      //     fortfarande ihop per deltagare (BIN-608) tills sessionens 7-dagars-TTL
      //     städar bort dem. En guard på update skulle frysa dem mitt i en session.
      //
      // recordSwipe (src/lib/firebase/sessions.ts) är enda skribenten och går
      // alltid via mediaTypeDocId() med tmdbId typad `number` — kanonisk per
      // konstruktion, så ingen legitim skrivning kan nekas av den här regeln.
      //
      // BIN-766 gav den här regeln en TVILLING: `canonicalWatchlistDocId` i
      // `users/{uid}/watchlist/{itemId}`-blocket ovan, med samma uttryck ordagrant.
      // De är avsiktligt två kopior — rules-språket tillåter en hoistad hjälpare,
      // men de två samlingarna har olika legacy-arv och kan behöva glida isär.
      // Det som INTE får hända är att bara den ena ändras; BIN-797 (2026-08-24)
      // smalnade av `_0` i båda samtidigt.
      function canonicalSwipeDocId(id) {
        return id.matches('^(movie|tv)_[1-9][0-9]*$');
      }
      function swipeShapeOk() {
        return request.resource.data.keys().hasOnly(['votes', 'updatedAt'])
          && request.resource.data.votes is map
          && request.resource.data.votes.size() <= 50;
      }
      // Add-only-skrivning av EN ny röstnyckel på en anonym plats: befintliga
      // röster får varken ändras eller tas bort. Gäller alla anropare — även
      // en inloggad vars plats skapades anonymt (joinade utloggad, loggade in
      // mitt i sessionen). Baksidan: en anonym deltagare kan inte ÄNDRA sin
      // egen redan lagda röst (går inte att skilja från förfalskning av en
      // annan anonym plats) — recordSwipe lägger bara första-röster, så inget
      // legitimt flöde träffar det.
      // BIN-542: diff() bunden EN gång (d). `added` måste däremot vara
      // List-formen keys().removeAll(...) — d.addedKeys() är en Set och kan
      // inte indexeras med [0].
      function anonVoteAddOk() {
        let d = request.resource.data.votes.diff(resource.data.votes);
        let added = request.resource.data.votes.keys().removeAll(resource.data.votes.keys());
        return d.changedKeys().size() == 0
          && d.removedKeys().size() == 0
          && added.size() == 1
          && validVote(request.resource.data.votes[added[0]])
          && voteKeyIsAnonSlot(added[0]);
      }

      // Anonyma deltagare tillåts (länk-delning utan inloggning) — men
      // skrivningar måste följa fältkontraktet så ingen kan spamma godtyckliga
      // fält eller blåsa upp dokumenten (kostnads-/skräp-skydd, H2).
      match /participants/{pid} {
        allow read: if true;
        allow create, update: if
          // BIN-509 (skärper BIN-24): en inloggad skriver sin EGEN plats —
          // både uid-FÄLTET (BIN-24) och dokument-VÄGEN (pid) binds till
          // auth.uid (klienten sätter alltid pid = uid för inloggade).
          // Anonyma platser (uid null före och efter skrivningen) får skrivas
          // av vem som helst med länken (token-modellen) — men en befintlig
          // plats med uid != null kan bara skrivas av sin ägare: ingen kan
          // längre ta över en annans plats eller strippa dess identitet.
          (
            (request.auth != null
              && pid == request.auth.uid
              && request.resource.data.uid == request.auth.uid)
            || (request.resource.data.uid == null
              && (resource == null || resource.data.uid == null)
              // Anon-plats får BARA ligga på en token-formad väg — annars kunde
              // en angripare förplantera en spökplats på ett offers uid-väg och
              // förfalska en röst som blir offrets efter join (BIN-509 sec-review).
              && anonShapedPid(pid))
          )
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'providers', 'vetoRemaining',
            'isHost', 'joinedAt', 'lastActiveAt'
          ])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.providers is list
          && request.resource.data.providers.size() <= 100
          // BIN-540: fälten fanns i hasOnly-listan men hade inga VÄRDEN
          // validerade — en länk-innehavare kunde sätta vetoRemaining till
          // vad som helst (obegränsat veto) eller göra isHost till en sträng.
          // vetoRemaining: 1 vid join, 0 efter använt veto — inget annat.
          && request.resource.data.vetoRemaining is int
          && request.resource.data.vetoRemaining >= 0
          && request.resource.data.vetoRemaining <= 1
          // ...och "inget annat" måste vara en SPÄRR, inte bara ett intervall:
          // utan spärr kunde en deltagare skriva tillbaka sin egen förbrukade
          // plats (0) till 1 hur många gånger som helst och veto:a obegränsat
          // (recordSwipe är app-konvention, inte gräns). Budgeten får bara
          // räknas NED. Default 1 = plats utan fältet räknas som oförbrukad.
          // Taket måste tåla ett FELTYPAT lagrat värde, inte bara ett saknat.
          // Före BIN-540 validerades inga värden, så en länk-innehavare kunde
          // plantera vetoRemaining: 'many' på NÅGON ANNANS anonyma plats. Utan
          // is-int-vakten nedan blir jämförelsen 0 <= 'many' — ett typfel som
          // fäller HELA allow-uttrycket, varje gång, för den platsen. Offret
          // kunde då varken heartbeata, veto:a eller gå med igen under
          // sessionens 7 dagar, utan någon väg tillbaka i klienten. Skräpvärde
          // behandlas därför som frånvarande (= 1, oförbrukad).
          && request.resource.data.vetoRemaining <= (
            resource == null || !(resource.data.get('vetoRemaining', 1) is int)
              ? 1
              : resource.data.get('vetoRemaining', 1)
          )
          // isHost är kosmetisk (★ i deltagarlistan), men ska ändå vara bool
          // och oföränderlig efter create — ingen kan promota sig till värd i
          // listan. Bindning mot sessionens hostUid skulle kräva en get() per
          // skrivning (kostnad) och ger inget utöver detta.
          && request.resource.data.isHost is bool
          // Samma försvar som vetoRemaining ovan, i två steg. En SAKNAD isHost
          // ger default false via .get(), så oföränderligheten håller. Men ett
          // närvarande men FELTYPAT värde ('yes') returneras som det är av
          // .get() — då skulle en ren likhetsjämförelse fälla varje framtida
          // skrivning och låsa platsen permanent (planJoinFields skriver
          // isHost:false för att läka, men false == 'yes' nekas). Därför: är det
          // lagrade värdet ett giltigt bool gäller oföränderlighet; är det skräp
          // måste det nya värdet vara false — den enda säkra läkningen, så ingen
          // kan promota sig till värd via glappet.
          && (
            resource == null
              ? true
              : resource.data.get('isHost', false) is bool
                ? request.resource.data.isHost == resource.data.get('isHost', false)
                : request.resource.data.isHost == false
          );
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostUid == request.auth.uid;
      }

      match /swipes/{tmdbId} {
        allow read: if true;
        // BIN-509: första rösten på en titel SKAPAR dokumentet — create-grenen
        // får aldrig röra resource.data (diff() på create kastar och skulle
        // neka alla legitima förstaröster; alla .diff()-användningar i filen
        // är update-only av samma skäl).
        allow create: if canonicalSwipeDocId(tmdbId)
          && swipeShapeOk()
          && request.resource.data.votes.size() == 1
          && validVote(request.resource.data.votes[request.resource.data.votes.keys()[0]])
          && (
            (request.auth != null
              && request.resource.data.votes.keys().hasOnly([request.auth.uid]))
            || voteKeyIsAnonSlot(request.resource.data.votes.keys()[0])
          );
        // Update: en inloggad får ändra/lägga sin EGEN röstnyckel; annars
        // gäller add-only av en ny nyckel på en anonym plats. Ingen kan ändra
        // eller ta bort någon annans befintliga röst, och hela röst-mapen kan
        // aldrig bytas ut i ett svep (veto-storm/förfalskat matchresultat).
        allow update: if swipeShapeOk()
          && (
            (request.auth != null
              && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid])
              && validVote(request.resource.data.votes[request.auth.uid]))
            || anonVoteAddOk()
          );
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostUid == request.auth.uid;
      }
    }

    // ---- Permanenta grupper (Fas 2) ----
    // Group-doc: läsbar för inloggade (unlisted-link-modell — gruppe-ID är 20 tecken).
    // Subcollections är låsta till medlemmar.
    //
    // SÄKERHETSMODELL för invite-tokens:
    //
    // 1. Group-doc:et lagrar BARA hash:en av inbjudningstoken
    //    (inviteTokenHash, sha256). Plaintext-tokenet finns aldrig i
    //    Firestore — det lever bara i URL:en som ägaren delar och cachas
    //    client-side i localStorage.
    //
    // 2. Token-join verifieras via en sealed joinAttempts-subkollektion:
    //    a) Joiner skriver groups/{id}/joinAttempts/{auth.uid} med plaintext.
    //       Rule:n nedan hashar plaintext server-side och jämför mot lagrad
    //       hash — bara matching plaintext accepteras.
    //    b) Joiner uppdaterar groups/{id} för att lägga till sig själv i
    //       memberUids. Rule:n nedan kollar bara att joinAttempts/{uid}
    //       existerar — vilket bevisar att hash-checken passerade.
    //
    // 3. JoinAttempts har read: false så plaintext aldrig läses tillbaka.
    //    Bara joiner själv kan skriva eller radera sin egen attempt-doc.
    //
    // 4. Members + watchlist subcollections är låsta till faktiska medlemmar.
    //    Group-doc:et självt (namn, memberUids, hash, defaults) är
    //    fortfarande läsbart för alla inloggade — det är medvetet "unlisted
    //    link"-modell för att invite-preview ska kunna visa gruppnamn.
    match /groups/{groupId} {
      allow read: if isSignedIn();

      // BIN-1140/BIN-1128: dokumentets nyckelmängd och `name`s form.
      //
      // Före den här funktionen ställde ingen gren i hela blocket någon fråga om
      // vilka nycklar dokumentet får ha. Varje skrivare som
      // passerade någon gren kunde alltså lägga till toppnivåfält upp mot
      // dokumentgränsen, på ett dokument `allow read: if isSignedIn()` gör
      // läsbart för varje inloggat konto och som läses om vid varje
      // medlemskapskontroll. `name` hade heller ingen typ- eller längdgräns i
      // någon gren; formulärens 48 tecken är en UI-hint, inte en spärr.
      //
      // Listan är de fält `createGroup` skriver. Härled den, lita inte på
      // uppräkningen här:
      //   grep -n -A 10 "addDoc(collection(db, 'groups')" src/lib/firebase/groups.ts
      // Kommandot är skrivet utan klammerparenteser med flit: `logic.test.ts` i
      // functions/ läser det HÄR blocket genom att räkna klamrar från match-raden.
      // För SNÄV lista bryter gruppskapande i produktion; för VID lista lämnar
      // hålet öppet. Den är ett TAK, aldrig ett golv.
      //
      // Villkoret ligger EN gång och täcker både create och hela update-OR-satsen.
      // Det går därför att den mängden är fast: vid en update är
      // `request.resource.data` hela dokumentet EFTER skrivningen, inte patchen,
      // så varje gren ser samma nycklar oavsett vilka fält den själv rör — även
      // `disableInviteToken`, som bara sätter `inviteTokenHash: null`.
      //
      // MEDSKYLDIGA KÄLLOR. `functions/src/groupHandover/adminIo.ts` skriver till
      // samma dokument via Admin SDK och går förbi de här reglerna helt. Den kan
      // aldrig fällas här — men lägger den någonsin ett fält utanför listan, är det
      // nästa HELT ORELATERADE klientskrivning (ett namnbyte) som nekas, eftersom
      // det främmande fältet ligger kvar i `request.resource.data`. Bredda listan i
      // samma commit som en sådan Admin-SDK-skrivning, aldrig efteråt.
      //
      // Talet 48 är samma tal som `groupInvites.groupName` redan pinnas mot en bit
      // upp i filen. Regelspråket har ingen delad konstant, så de två måste flytta
      // i samma redigering.
      function isValidGroupDoc() {
        return request.resource.data.keys().hasOnly([
            'name', 'ownerUid', 'memberUids', 'defaults',
            'inviteTokenHash', 'inviteTokenRotatedAt', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 48;
      }

      allow create: if isSignedIn()
        && isValidGroupDoc()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.hasOnly([request.auth.uid])
        && request.auth.uid in request.resource.data.memberUids;

      // Tillåt: ägaren (write UTAN att lägga till andra uids), medlem som
      // lämnar (självborttag), gäst som joinar via länk (joinAttempts), eller
      // inbjuden användare som accepterar (groupInvites).
      //
      // VIKTIGT: ägaren kan INTE längre lägga till godtyckliga uids i
      // memberUids. hasAll(new) kräver att gamla memberUids är en supermängd av
      // de nya — dvs ägaren får bara ta bort medlemmar eller lämna listan
      // oförändrad. Tillägg sker alltid genom att mål-användaren själv
      // accepterar en inbjudan (accept-branchen nedan). Detta stänger H1 där
      // ägaren tyst kunde lägga till vem som helst utan samtycke.
      allow update: if isSignedIn() && isValidGroupDoc() && (
        (
          resource.data.ownerUid == request.auth.uid
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          // BIN-1108: agaren maste sta kvar i sin egen medlemslista. `hasAll` sager
          // bara att den nya listan ar en DELMANGD av den gamla, och en delmangd far
          // utelamna agaren sjalv. Utan det har villkoret kan agaren skriva bort sig
          // medan `ownerUid` fortfarande pekar pa dem - och varje agar-grindad atgard
          // loses upp mot `ownerUid`, sa gruppen blir permanent oforvaltbar for alla
          // andra: inget namnbyte, inga inbjudningar, ingen tokenrotation, ingen
          // radering. Ingen sopning fangar det heller; `retentionCleanup` fyrar forst
          // nar uid:t ar borta ur Auth, och en agare som bara lamnat ar ett levande
          // konto.
          //
          // Att ISTALLET lata grenen bara over agarskapet var vad #27 och #4 avvisade
          // i BIN-1063: regler kan inte iterera medlems-undersamlingen for att avgora
          // vem som varit med langst, sa garantin hade legat i klientkoden. Den
          // frivilliga vagen ut ar `handOverOwnedGroups`, som redan finns och kor pa
          // Admin SDK - alltsa forbi de har reglerna.
          && request.auth.uid in request.resource.data.memberUids
          // BIN-276: the owner branch is the ONLY legit rename path (updateGroup
          // patches name/defaults), so name/defaults stay mutable here — but pin
          // identity + invite-token fields so a member-remove write can't also
          // force-transfer ownerUid onto a victim or silently swap the invite
          // hash. Mirrors the pins on the leave/join/accept branches.
          && request.resource.data.ownerUid == resource.data.ownerUid
          && (!('inviteTokenHash' in request.resource.data)
            || request.resource.data.inviteTokenHash == resource.data.get('inviteTokenHash', null))
          && (!('inviteTokenRotatedAt' in request.resource.data)
            || request.resource.data.inviteTokenRotatedAt == resource.data.get('inviteTokenRotatedAt', null))
        )
        || (
          // Token-rotation / disable (rotateInviteToken + disableInviteToken in
          // groups.ts). The owner branch above PINS inviteTokenHash so a
          // membership edit can't silently swap it — but these legit owner flows
          // DO change the hash, so they get their own branch. Everything except
          // the token fields stays pinned, so this can't double as a membership/
          // ownership/settings edit (a member-remove + hash-swap changes
          // memberUids → fails the pin here AND the hash pin on the owner branch).
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.name == resource.data.name
          && request.resource.data.defaults == resource.data.defaults
        )
        || (
          // Medlem lämnar — tar bort sig själv
          request.auth.uid in resource.data.memberUids
          && !(request.auth.uid in request.resource.data.memberUids)
          // BIN-1108: agaren far inte anvanda DEN HAR grenen som utgang. Den kraver
          // bara medlemskap och pinnar `ownerUid` oforandrad, sa utan det har
          // villkoret naa agaren samma frysta lage genom att helt enkelt "lamna" -
          // och en fix som bara tatade agar-grenen ovan hade lamnat vagen oppen en
          // gren bort. Det galler ocksa den ensamme agaren: en grupp utan medlemmar
          // men med ett levande `ownerUid` ar samma tillstand. Agaren raderar gruppen
          // eller lamnar over den; hen lamnar den inte.
          && resource.data.ownerUid != request.auth.uid
          // BIN-327: leave may only SHRINK memberUids. Without this a leaving
          // member could set memberUids to a superset — injecting an arbitrary
          // uid as they exit, an uncapped growth path that bypasses the join/
          // accept size cap. hasAll(new ⊆ old) confines this branch to removal.
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          // BIN-365: leave removes EXACTLY the caller. hasAll confines to a subset
          // (shrink-only), but a subset still lets a leaving member drop a third
          // party. size()==old-1, combined with the self-absence check above,
          // means the one removed element is the caller and no bystander. size()
          // needs no null guard: `create` guarantees memberUids exists on every doc.
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.name == resource.data.name
          && request.resource.data.defaults == resource.data.defaults
          && (!('inviteTokenHash' in request.resource.data)
            || request.resource.data.inviteTokenHash == resource.data.get('inviteTokenHash', null))
          && (!('inviteTokenRotatedAt' in request.resource.data)
            || request.resource.data.inviteTokenRotatedAt == resource.data.get('inviteTokenRotatedAt', null))
        )
        || (
          // Token-join — bevisad genom att joinAttempts/{auth.uid} existerar
          // (vilket i sin tur kräver att hash-checken på den subcollection-
          // regeln nedan passerade).
          exists(/databases/$(database)/documents/groups/$(groupId)/joinAttempts/$(request.auth.uid))
          && !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          // BIN-1125: relate the NEW list to the OLD one. Until this landed, the two
          // growth branches only asserted that the writer had joined — nothing tied
          // the rest of the list to what was there before, so the same write could
          // drop everyone else. `ownerUid` is pinned below, so a third party with a
          // valid invite could leave the group pointing at an owner who is no longer
          // a member: BIN-1108's frozen end state, reached by someone other than the
          // owner. BIN-1108 closed the two branches that SHRINK the list on purpose;
          // these two shrink as a side effect of never comparing.
          //
          // Read the two clauses as a pair, not as independent bounds. `hasAll(old)`
          // is what closes the removal; the exact-plus-one size is what stops a
          // joiner from adding a stranger alongside themselves in the same write.
          //
          // The ticket proposed `old.hasAll(new.removeAll([self]))` for the first
          // half. That form is satisfied by a DUPLICATE: new `[self, self]` against
          // old `[owner]` passes every clause — removeAll strips both copies and
          // `hasAll([])` is true — while writing the owner out. `hasAll(old)` has no
          // such reading.
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          // BIN-327: bound the only two growth paths (join + accept) so memberUids
          // can't be inflated toward the 1 MiB doc limit / read-amplified on every
          // membership get(). size() is an in-payload check — zero extra get() cost.
          && request.resource.data.memberUids.size() <= 100
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.name == resource.data.name
          && request.resource.data.defaults == resource.data.defaults
          && (!('inviteTokenHash' in request.resource.data)
            || request.resource.data.inviteTokenHash == resource.data.get('inviteTokenHash', null))
          && (!('inviteTokenRotatedAt' in request.resource.data)
            || request.resource.data.inviteTokenRotatedAt == resource.data.get('inviteTokenRotatedAt', null))
        )
        || (
          // Invite-accept — bevisad genom att en inbjudan finns på
          // users/{auth.uid}/groupInvites/{groupId} (skapad av ägaren).
          // Användaren lägger BARA till sig själv. Samma oförändrade-fält-
          // villkor som join-branchen.
          exists(/databases/$(database)/documents/users/$(request.auth.uid)/groupInvites/$(groupId))
          && !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)   // BIN-1125 (see join branch)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.size() <= 100   // BIN-327 (see join branch)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.name == resource.data.name
          && request.resource.data.defaults == resource.data.defaults
          && (!('inviteTokenHash' in request.resource.data)
            || request.resource.data.inviteTokenHash == resource.data.get('inviteTokenHash', null))
          && (!('inviteTokenRotatedAt' in request.resource.data)
            || request.resource.data.inviteTokenRotatedAt == resource.data.get('inviteTokenRotatedAt', null))
        )
      );

      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;

      // ---- joinAttempts ----
      // Sealed-after-create. Plaintext-token i payload jämförs server-side
      // mot hash:en på parent-doc:et. Aldrig läsbar — finns bara för
      // existens-check från group-update-regeln.
      match /joinAttempts/{uid} {
        allow read: if false;
        allow create: if isSignedIn()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['token', 'createdAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 256
          // BIN-480: pin createdAt to request.time (mirrors the household
          // updatedAt pattern) so a hand-crafted create can't stamp a non-
          // timestamp or future date — retentionCleanup reaps joinAttempts by
          // createdAt, and an undateable doc would be retained forever (Art. 17
          // backstop gap). The legit client writes serverTimestamp() → request.time.
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/groups/$(groupId)).data.inviteTokenHash != null
          && hashing.sha256(request.resource.data.token).toHexString().lower()
             == get(/databases/$(database)/documents/groups/$(groupId)).data.inviteTokenHash;
        allow update: if false;
        // Självborttag tillåten så joiner kan rensa upp efter lyckad join
        // eller försöka igen med ny token efter rotation.
        allow delete: if isSignedIn() && uid == request.auth.uid;
      }

      match /members/{memberUid} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;

        // Sig själv (men bara om man faktiskt är medlem i gruppen — L1) eller
        // ägaren kan skriva. Utan medlemskaps-villkoret kunde vem som helst
        // skriva en självmedlemskaps-doc i en godtycklig grupp.
        //
        // BIN-1063 steg 1 delade den tidigare gemensamma create/update/delete-raden
        // i tre. Uttrycket nedan ÄR den raden, oförändrat och bara namngivet — inget
        // villkor tillkom. Delningen behövs för att create och update ska kunna bära
        // olika joinedAt-krav utan att delete får någon referens till fältet alls:
        // en delete bär ingen request.resource, så ett gemensamt villkor som rörde
        // fältet hade nekat varje borttagning och gjort medlemsdokumentet oraderbart.
        function selfOrOwner() {
          return isSignedIn() && (
            (
              request.auth.uid == memberUid
              && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
            )
            || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid
          );
        }

        // BIN-1155: dokumentets nyckelmängd och varje fälts form.
        //
        // Före den här funktionen ställde ingen gren i medlemsblocket någon fråga om
        // vilka nycklar dokumentet får ha eller hur stora värdena får vara: ett
        // `grep -c hasOnly` över medlemsblocket gav 0.
        // (Kommandot skrivs utan klamrar med flit — `logic.test.ts` i functions/ läser
        // det HÄR trädet genom att räkna klamrar från match-raden, och en ensam
        // klammer i en kommentar stänger dess skanning i förtid. Golvet i det testet
        // fångade precis det.) Dokumentet är
        // läsbart för VARJE medlem i gruppen, så en godtycklig skrivare kunde lägga
        // toppnivåfält upp mot dokumentgränsen på något alla i gruppen läser om.
        //
        // Listan är de fält `memberFields()` skriver, plus `joinedAt`. Härled den,
        // lita inte på uppräkningen här:
        //   grep -n -A 10 "function memberFields" src/lib/firebase/groups.ts
        // För SNÄV lista bryter gruppskapande och join i produktion; för VID lämnar
        // hålet öppet. Den är ett TAK, aldrig ett golv.
        //
        // MEDSKYLDIGA KÄLLOR. Mätt 2026-09-12 skriver `functions/` inga fält till det
        // här dokumentet — den läser det och raderar det. Börjar en Admin-SDK-väg
        // skriva ett fält hit måste listan vidgas i SAMMA commit, annars är det nästa
        // HELT ORELATERADE klientskrivning som nekas: vid en update är
        // `request.resource.data` hela dokumentet EFTER skrivningen, inte patchen, så
        // ett främmande fält ligger kvar i den och fälls av `hasOnly`. Samma skäl gör
        // att en rad som inte uppfyller värdegränserna blir permanent oredigerbar.
        //
        // TALEN HAR VAR SIN EGEN KÄLLA och får aldrig gissas ur en granne. `displayName`
        // följer `MAX_DISPLAY_NAME` i src/lib/clampText.ts (80) — samma tak som
        // `users/{uid}` och `publicProfiles/{uid}`, INTE gruppnamnets 48. Ett snävare
        // tak här hade nekat BIN-1162:s omskrivning för den vars namn ryms i profilen
        // men inte på medlemsraden, och den staleness läker aldrig. `username` går
        // genom `isValidUsername`, `photoURL` mot projektionens 500, `providers` mot
        // samma listtak som Tillsammans-deltagarna.
        //
        // Varje fält prövas BARA om det finns, som `isValidPublicProfile` gör: ett
        // dokument som saknar en nyckel ska gå att uppdatera vidare, inte låsas.
        function isValidGroupMember(d) {
          return d.keys().hasOnly(['uid', 'displayName', 'username', 'photoURL', 'providers', 'joinedAt'])
            // uid får peka på precis en rad: sin egen. `memberDocToObject` föredrar
            // FÄLTET framför dokument-id:t och `GroupMembersPanel` skickar fältets
            // värde till `removeMember`, så ett förfalskat uid fick ägarens nästa
            // "ta bort"-klick att radera en annan medlem. Samma form som
            // sessions/.../participants redan stängde i BIN-509/BIN-24.
            && (!('uid' in d) || d.uid == memberUid)
            && (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 80))
            && (!('username' in d) || d.username == null || isValidUsername(d.username))
            && (!('photoURL' in d) || d.photoURL == null
              || (d.photoURL is string && d.photoURL.size() <= 500))
            && (!('providers' in d) || (d.providers is list && d.providers.size() <= 100));
        }

        // joinedAt pinnas till serverns commit-tid, samma mönster som joinAttempts
        // createdAt (BIN-480) och household updatedAt. Fältet blir tilldelningsnyckeln
        // när en ägarlös grupp lämnas över till den medlem som varit med längst
        // (BIN-1063 steg 3). Klientskrivet var det godtyckligt: vilken medlem som helst
        // kunde sätta sitt eget till 1970 och vinna varje framtida överlämning i varje
        // grupp den är med i. Varje skrivväg som sätter fältet gör det med
        // serverTimestamp(), som löser ut till exakt request.time — även inne i en
        // batch, där hela commiten delar en request.time. Härled vägarna i stället
        // för att lita på den här meningen:
        //   grep -n "'members'" src/lib/firebase/groups.ts
        allow create: if selfOrOwner()
          && isValidGroupMember(request.resource.data)
          && matchesOwnIdentity(request.resource.data)
          && request.resource.data.joinedAt == request.time;

        // Oföränderligt efteråt. Uppslag med default på BÅDA sidor, aldrig ett bart
        // fältuppslag: ett medlemsdokument utan fältet — skrivet utanför appen, t.ex.
        // för hand i konsolen — skulle med bar uppslagning aldrig gå att uppdatera
        // igen, och updateMemberProviders låstes ute tills doc:et reparerats manuellt.
        // Saknas fältet på båda sidor jämförs null mot null och en uppdatering av
        // något ANNAT fält går igenom.
        // BIN-1155: identitetsfälten binds till skrivarens EGEN live-profil, samma
        // `matchesOwnIdentity` som recensioner, kommentarer och reaktioner redan bär.
        // Panelen var splittrad på den här punkten 2026-09-11 — databasansvarige
        // blockerade PÅ bindningen, eftersom den läser live-värdet medan appen skickade
        // den kopia som låg i minnet. Den invändningen är upplöst: kopian hålls färsk
        // mellan flikar sedan BIN-1163.
        //
        // Villkoret gäller BÅDA grenarna i `selfOrOwner()` med flit. Ägargrenen kunde
        // annars skriva ett godtyckligt namn på en ANNAN medlems rad — ingen klientväg
        // gör det i dag (ägarens enda skrivning mot en främmande rad är en delete, som
        // inte bär någon request.resource), men en bindning som bara gäller ena grenen
        // hade lämnat formen öppen för nästa skrivare.
        //
        // PÅ UPDATE binds bara ett fält som FAKTISKT ÄNDRAS, och det är inte en
        // uppmjukning utan en rättelse. `request.resource.data` är hela dokumentet
        // EFTER skrivningen, inte patchen, så en rad vars lagrade namn hunnit bli
        // inaktuellt — precis den rest BIN-1162:s daterade post accepterar — hade
        // annars fällt VARJE uppdatering av raden, inklusive en `providers`-patch som
        // aldrig rör identiteten. Det hade stängt just den läkningsväg posten vilar på.
        // Förfalskningen är ändå omöjlig: att ÄNDRA fältet till något som inte är ditt
        // kräver fortfarande din egen live-profil.
        //
        // `!= null` ar inte dekorativt. `isOwnIdentity` slapper igenom null med flit —
        // pa en CREATE betyder det "faltet skickades inte", och dar fangas ett faktiskt
        // null anda av typkontrollen i `isValidGroupMember`. Pa en UPDATE finns en tredje
        // form: `deleteField()` TAR BORT nyckeln, och da ser bade typkontrollen och
        // `isOwnIdentity` ett franvarande falt och slapper igenom. Utan villkoret nedan
        // kunde alltsa vem som helst med skrivratt — inklusive agaren pa en ANNAN
        // medlems rad — RADERA namnet i stallet for att andra det, och bindningen hade
        // inte jamfort mot nagot alls. Att forfalska ar stangt; att tomma var det inte.
        function keepsOrOwnsIdentity() {
          return (request.resource.data.get('displayName', null) == resource.data.get('displayName', null)
              || (request.resource.data.get('displayName', null) != null
                && isOwnIdentity(request.resource.data.get('displayName', null), null)))
            && (request.resource.data.get('username', null) == resource.data.get('username', null)
              || (request.resource.data.get('username', null) != null
                && isOwnIdentity(null, request.resource.data.get('username', null))));
        }

        allow update: if selfOrOwner()
          && isValidGroupMember(request.resource.data)
          && keepsOrOwnsIdentity()
          && request.resource.data.get('joinedAt', null) == resource.data.get('joinedAt', null);

        allow delete: if selfOrOwner();
      }

      // Session-historik: avtryck av Tillsammans-sessioner som gruppen
      // startat och valt en titel ifrån. Skrivs av session-deltagaren med
      // 'Den här tar vi'-knappen i match-vyn. Läses av alla gruppmedlemmar
      // som "Senaste filmkvällar" på grupp-sidan.
      match /sessionHistory/{sessionId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        // Vem som helst i gruppen som var med i sessionen kan logga pick:en.
        // (Strikt: vi kan inte verifiera att de "var med" utan att läsa
        // sessions/{sessionId}/participants — vilket skulle göra reglerna
        // tunga. Begränsar i stället till gruppmedlemmar och vägrar bara
        // om sessionen inte är groupId-bunden, men det görs i klienten.)
        // Fältkontrakt (L3) — matchar exakt vad recordGroupSessionPick skriver
        // (groups.ts). hasOnly + typ-/storleksvalidering hindrar skräpfält och
        // uppblåsta dokument.
        allow create, update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
          && request.resource.data.sessionId == sessionId
          && request.resource.data.keys().hasOnly([
            'sessionId', 'pickedByUid', 'pickedTmdbId', 'mediaType', 'mediaTitle',
            'posterPath', 'participantUids', 'pickedAt'
          ])
          // Skribenten måste logga sig själv som pick:are — gör det omöjligt
          // att förfalska vem som valde (push-functionen litar på fältet).
          && request.resource.data.pickedByUid == request.auth.uid
          && request.resource.data.pickedTmdbId is int
          && request.resource.data.pickedTmdbId > 0
          && request.resource.data.mediaType in ['movie', 'tv']
          && request.resource.data.mediaTitle is string
          && request.resource.data.mediaTitle.size() <= 300
          && (request.resource.data.posterPath == null
            || (request.resource.data.posterPath is string && request.resource.data.posterPath.size() <= 300))
          && request.resource.data.participantUids is list
          && request.resource.data.participantUids.size() <= 50;
        // Bara ägare av gruppen kan radera historiken.
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid;
      }

      match /watchlist/{tmdbId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;

        allow create, update, delete: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;

        // Per-medlem progress på en titel i gruppen. Möjliggör spoiler-skydd
        // och "var ligger ni"-vy oavsett medlemmens privata visibility.
        // Läsåtkomst: alla gruppmedlemmar (gruppmedlemskap är access-line:n,
        // inte profil-publik-flaggan). Skrivåtkomst: bara progress-doc-ägaren.
        match /progress/{progressUid} {
          allow read: if isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
          allow create, update, delete: if isOwner(progressUid)
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        }
      }

      // BIN-184: Hushåll — opt-in delade prenumerationsbidrag (kostnadsdata).
      // Opt-in = att medlemmen själv skriver sitt doc; payloaden byggs client-
      // side utan tier-namn (DPO-minimering). Till skillnad från progress-
      // mönstret valideras form + storlek hårt: doc:et bär öppna maps som
      // annars vore attacker-sized (Security #4). updatedAt pinnas till
      // request.time så ålders-stämpeln ("senast uppdaterad") inte kan förfalskas.
      //
      // LÄS kräver reciprocitet (share-to-see, ADR 0010): bara medlemmar som
      // själva delar (har ett eget household-doc) får läsa andras bidrag —
      // första gången medlemskaps-linjen INTE räcker som access-line, eftersom
      // detta är pengadata, inte watch-status.
      //
      // DELETE: medlemmen själv (opt-out — utan medlemskrav, så ett kvarlämnat
      // doc alltid kan självstädas) eller ägaren (removeMember-städning).
      match /household/{householdUid} {
        // GET på sitt EGET doc är alltid tillåtet — även när det inte finns
        // (export/radering får då exists()=false istället för permission-denied;
        // rules är inte filter, xhigh-review 2026-07-05) och även efter utträde
        // (självstädning + Art. 20-export). Andras docs kräver share-to-see.
        allow get: if isSignedIn()
          && (request.auth.uid == householdUid
            || (request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
              && exists(/databases/$(database)/documents/groups/$(groupId)/household/$(request.auth.uid))));

        // LIST förblir strikt reciprok (share-to-see, ADR 0010). OBS: klient-
        // flöden får ALDRIG lista household som del av radering — deletion-refs
        // härleds ur medlems-id:na (accountDeletion/deleteGroup) just för att en
        // icke-delande ägare inte kan lista.
        allow list: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
          && exists(/databases/$(database)/documents/groups/$(groupId)/household/$(request.auth.uid));

        allow create, update: if isOwner(householdUid)
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids
          && request.resource.data.keys().hasAll(['providerIds', 'providerCosts', 'providerCampaigns', 'activeProviderIds', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['providerIds', 'providerCosts', 'providerCampaigns', 'activeProviderIds', 'updatedAt'])
          && request.resource.data.providerIds is list
          && request.resource.data.providerIds.size() <= 100
          && request.resource.data.activeProviderIds is list
          && request.resource.data.activeProviderIds.size() <= 100
          && request.resource.data.providerCosts is map
          && request.resource.data.providerCosts.size() <= 100
          && request.resource.data.providerCampaigns is map
          && request.resource.data.providerCampaigns.size() <= 100
          && request.resource.data.updatedAt == request.time;

        allow delete: if isSignedIn()
          && (request.auth.uid == householdUid
            || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid);
      }
    }
  }
}

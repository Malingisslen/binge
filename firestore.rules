rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Usernames: 3-20 chars, lowercase a-z, 0-9, underscore and dash;
    // must start and end with alphanumeric. Matches client regex in
    // src/lib/firebase/username.ts.
    function isValidUsername(u) {
      return u is string
        && u.size() >= 3 && u.size() <= 20
        && u.matches('^[a-z0-9]([a-z0-9_-]{1,18}[a-z0-9])?$');
    }

    // Reviews content bounds.
    function isValidReview(d) {
      return d.uid is string
        && d.tmdbId is int && d.tmdbId > 0
        && d.mediaType in ['movie', 'tv']
        && d.text is string && d.text.size() <= 5000
        && (!('rating' in d) || d.rating == null || (d.rating is number && d.rating >= 0 && d.rating <= 10))
        && (!('spoiler' in d) || d.spoiler is bool);
    }

    // Comment content bounds.
    function isValidComment(d) {
      return d.uid is string
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 1000;
    }

    // List content bounds.
    function isValidList(d) {
      return d.uid is string
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 100
        && (!('description' in d) || d.description is string && d.description.size() <= 500)
        && d.isPublic is bool;
    }

    // ---- users ----
    // User profile — owner only (public read handled by isPublic check in app)
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      allow read: if resource.data.isPublic == true;
    }
    match /users/{uid}/watchlist/{itemId} {
      allow read, write: if isOwner(uid);
      // Snabb-regel: resource.data.isPublic är denormaliserad från parent-profil.
      // WatchlistContext stämplar isPublic vid skrivning och AuthContext.update
      // IsPublic cascadar när profilen toggles. Sparar en extra doc-read per
      // item (500 items → 500 färre reads).
      allow read: if resource.data.isPublic == true;
      // Legacy-fallback för items som skrevs innan 9.3 landade. Kostar en get()
      // per doc men håller bakåtkompat tills alla items cascade-stämplats.
      allow read: if !('isPublic' in resource.data)
        && get(/databases/$(database)/documents/users/$(uid)).data.isPublic == true;
    }
    match /users/{uid}/episodeProgress/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/notInterested/{itemId} {
      allow read, write: if isOwner(uid);
    }

    // Blockerade användare — endast ägaren läser/skriver. Klient-filter i UI
    // gömmer blockerad användares innehåll (hygien-nivå, inte säkerhetsgräns).
    match /users/{uid}/blocked/{targetUid} {
      allow read, write: if isOwner(uid);
    }

    // Notifications — owner only
    match /users/{uid}/notifications/{notifId} {
      allow read, write: if isOwner(uid);
    }

    // Follow system
    match /users/{uid}/following/{targetUid} {
      allow read, write: if isOwner(uid);
      allow read: if get(/databases/$(database)/documents/users/$(uid)).data.isPublic == true;
    }
    match /users/{uid}/followers/{followerUid} {
      allow read: if isOwner(uid);
      allow read: if get(/databases/$(database)/documents/users/$(uid)).data.isPublic == true;
      allow write: if isOwner(followerUid);
    }

    // ---- usernames ----
    // Username lookup — anyone can read, owner can create/delete.
    // Path-segment username must be normalized (lowercase, 3-30, [a-z0-9_]).
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isValidUsername(username);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- reviews ----
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isValidReview(request.resource.data);
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid  // can't transfer ownership
        && isValidReview(request.resource.data);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Likes — each signed-in user owns their own like doc (doc-id = uid).
      match /likes/{uid} {
        allow read: if true;
        allow create, delete: if isOwner(uid);
      }

      // Comments — any signed-in user may comment; author or review-author may delete.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && isValidComment(request.resource.data);
        allow delete: if isSignedIn() && (
          resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/reviews/$(reviewId)).data.uid == request.auth.uid
        );
      }
    }

    // ---- reports (UGC-moderation) ----
    // Inloggade användare kan skapa rapporter. Läsning sker off-line via
    // Firebase Console av admins — inga klienter har read-access. Ingen
    // klient kan heller uppdatera eller radera en rapport (admin sätter
    // status via console).
    //
    // Rate-limit: vi litar på klient-cooldown (1 s) + vi begränsar
    // note-size via valideringsregel. En hårdare rate-limit (per user per
    // timme) lägger vi in när vi ser abuse-mönster.
    match /reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason in ['spam', 'hate', 'harassment', 'illegal', 'pii', 'other']
        && request.resource.data.targetType in ['review', 'comment', 'user', 'list']
        && request.resource.data.targetId is string
        && request.resource.data.targetOwnerUid is string
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500));
      allow update, delete: if false;
    }

    // ---- lists ----
    match /lists/{listId} {
      allow read: if resource.data.isPublic == true
        || (isSignedIn() && request.auth.uid == resource.data.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isValidList(request.resource.data);
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && isValidList(request.resource.data);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- Tillsammans-sessioner ----
    // Alla med sessions-länken kan läsa/skriva. Ingen värdefull data lagras
    // (bara anonyma röster), så unlisted-link-modellen räcker.
    // Sessioner kräver dock numera autentisering för att skapas
    // (tidigare tillät null hostUid — skräp- och abuse-vektor).
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.hostUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;

      match /participants/{pid} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostUid == request.auth.uid;
      }

      match /swipes/{tmdbId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostUid == request.auth.uid;
      }
    }

    // ---- Permanenta grupper (Fas 2) ----
    // Group-doc: läsbar för inloggade (unlisted-link-modell — gruppe-ID är 20 tecken).
    // Subcollections är låsta till medlemmar.
    match /groups/{groupId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.hasOnly([request.auth.uid])
        && request.auth.uid in request.resource.data.memberUids;

      // Tillåt: ägaren (full write), medlem som lämnar (självborttag), gäst som joinar via giltig token
      allow update: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid
        || (
          // Medlem lämnar — tar bort sig själv
          request.auth.uid in resource.data.memberUids
          && !(request.auth.uid in request.resource.data.memberUids)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.name == resource.data.name
          && request.resource.data.defaults == resource.data.defaults
          && request.resource.data.inviteToken == resource.data.inviteToken
        )
        || (
          // Token-join — lägger till sig själv, övriga fält oförändrade
          resource.data.inviteToken != null
          && request.resource.data.inviteToken == resource.data.inviteToken
          && !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.name == resource.data.name
          && request.resource.data.defaults == resource.data.defaults
        )
      );

      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;

        // Sig själv eller ägaren kan skriva
        allow create, update, delete: if isSignedIn() && (
          request.auth.uid == memberUid
          || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid
        );
      }

      match /watchlist/{tmdbId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;

        allow create, update, delete: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
      }
    }
  }
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
auth-debug.log
emulator-data/

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code. The CONFIG is versioned — rules, agents, hooks, gate settings and
# shared-plugin.json are what make the gates exist, and an unversioned gate is one
# machine loss away from being gone. Only genuinely per-run state stays out.
# (Butlery and webbkollen have always tracked theirs; this repo was the outlier.)
.claude/state/
.claude/worktrees/
.claude/cache/
.claude/hooks/sessions/
.claude/hooks/__pycache__/
.claude/linear-tracker.json
.claude/scheduled_tasks.lock
.claude/*.doctor-backup
.superpowers/
.worktrees/

# lokala lighthouse-audits (regenereras via scripts/serve-spa.mjs + lighthouse CLI)
.lighthouse/

# TMDB-byggcache (persistas mellan CI-körningar via actions/cache, aldrig committad)
.tmdb-cache/

# /brag skill output (local launch video + share copy — never commit the mp4 blob)
brag-output/
brag-output-*/

# BIN-185 recaps — service-account key + local generation working files (NEVER commit)
*serviceaccount*.json
*service-account*.json
*recaps-writer*.json
*firebase-adminsdk*.json
scripts/recaps/*

# engångs-scratchskript (underscore-prefix) — verktyg för en session, aldrig committade
functions/scripts/_*.mjs


# Reviewer scratch rigs — isolated vitest copies an agent builds to mutate safely.
# Untracked AND ignored: a `git add -A` would otherwise stage a whole rig into the repo
# (integration review, 2026-08-13).
.review-rig/

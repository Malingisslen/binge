{
  "name": "binge-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "analyze": "cross-env ANALYZE=true NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "check:knowledge-caps": "node scripts/check-knowledge-caps.mjs",
    "preflight": "node scripts/shared-guard.mjs check-toolchain",
    "worktree-cleanup": "node scripts/shared-guard.mjs worktree-cleanup",
    "prelint": "node scripts/shared-guard.mjs check-toolchain",
    "lint": "eslint .",
    "pretypecheck": "node scripts/shared-guard.mjs check-toolchain",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/shared-guard.mjs check-toolchain",
    "test": "vitest run",
    "pretest:coverage": "node scripts/shared-guard.mjs check-toolchain",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:rules": "firebase emulators:exec --only firestore --project demo-binge-rules \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore",
    "emulators:export": "firebase emulators:export ./emulator-data",
    "emulators:import": "firebase emulators:start --only auth,firestore --import=./emulator-data"
  },
  "dependencies": {
    "@sentry/react": "^10.71.0",
    "@tanstack/query-sync-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "firebase": "^12.18.0",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@next/bundle-analyzer": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "msw": "^2.15.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}

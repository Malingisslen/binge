+/** Top box: how many reports wait. Re-reads when the list on screen changes, so it follows a decision. */
+function OpenSummary({ onShowOpen, refreshKey }: { onShowOpen: () => void; refreshKey: unknown }) {
+  const open = useQuery({
+    queryKey: ['admin-open-reports', refreshKey],
+    queryFn: () => listReports({ status: 'open' }),
+    staleTime: 0,
+    retry: false,
+  });
+  if (open.isError) return null;
+  if (!open.data) return null;
+  const n = open.data.length;
+  const count = n >= 100 ? '100 eller fler' : String(n);
+  return n === 0 ? (
+    <div className="mb-3 rounded-sm border border-success bg-surface px-3 py-2 text-sm text-ink" role="status">
+      ✓ Inga anmälningar väntar.
+    </div>
+  ) : (
+    <div className="mb-3 rounded-sm border border-warn-deep bg-warn-soft px-3 py-2 text-sm text-warn-ink" role="status">
+      <span className="font-semibold">{count} {n === 1 ? 'anmälan väntar' : 'anmälningar väntar'}</span> på beslut.{' '}
+      <button type="button" onClick={onShowOpen} className="underline cursor-pointer">Visa dem</button>
+    </div>
+  );
+}
